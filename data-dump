INSERT INTO public.chemsapp_product VALUES (410, 'Aquamatic', 'documents/Aquamatic_5kg.jpg', 'documents/Dishwash_Powder_Icon.png', '', 'Fill machine dispenser or hopper and run machine cycle. May be used as
