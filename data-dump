INSERT INTO public.chemsapp_product VALUES (473, 'Spray N Wipe', 'documents/Rapid_Green_Spray_N_Wipe_5L.jpg', 'documents/Spray_Surface_Icon_1Wobu7M.png', '', 'Bucket & Mop:
