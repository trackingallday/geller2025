INSERT INTO public.chemsapp_product VALUES (411, 'Spot Free Rinse Aid', 'documents/SpotFree_5L.jpg', 'documents/Rinse_Aid_Icon_6CK6QUe.png', '', 'SPOT FREE RINSE AID is introduced during the rinse cycle at a very low concentraon of 7-10 mL/45L of water via automatic dosing equipment. This equipment is provided and serviced by Jasol Australia. For best results flash drying at 80-90ºC is recommended. In domesc dishwashers the rinse addive is dispensed from a small reservoir unit which must be kept full.

SPOT FREE RINSE AID may also be used manually. A few mL of SPOT FREE RINSE AID should be added to a sink of almost boiling water. Immerse the articles to be rinsed in this solution using a basket or a tray, remove and allow to drain.', 'C2001920L05', 'Caskade', 'documents/SpotFree_PI.pdf', 'documents/CASKADE_SPOT_FREE_RINSE_SDS.pdf', 72, 'SPOT FREE RINSE AID is a rinse additive for use in automatic dishwashers. It promotes free rinsing and prevents water spotting and streaking leaving crockery and cutlery sparkling. Coupled with the use of hot water, SPOT FREE RINSE AID ensures fast drying times, and tableware is swiftly returned for re-use. Manual drying is eliminated thus reducing labour costs and also preventing cross-infection from the use of towels.', false, '', '', 'C2000940L20
C2000580L200', 'Premium Rinse Aid for Automatic Dishwashing Machines', 'Premium Rinse Aid for Automatic Dishwashing Machines');
INSERT INTO public.chemsapp_product VALUES (412, 'High Ace', 'documents/High_Ace_Red_5L.jpg', 'documents/Glasswash_Icon.png', '', 'Inject undiluted directly into wash water at a ratio of 1.5-3mls per litre via an automatic peristalitic pump.
Not recommended for manual dosing, unless in contingency commercial situations.', 'C2001960L05', 'Caskade', 'documents/High_Ace_PI.pdf', 'documents/CASKADE_HIGHACE_SDS_2021.pdf', 72, 'High Ace is a performance liquid designed to clean glassware effectively in all glass washing machines in both hard and soft water areas. High Ace will remove difficult soils as lipstick from glassware and crockery, its free rinsing properties will allow the ware to dry spotlessly, thus eliminating the need for a rinse additive. High  Ace is designed for trouble-free dosing to offer more consistent wash performance, fewer service requirements and lower overall cost. High Ace contains sequestrants, deflocculating agents, peptising agents, soil suspending agents, pink dye, and a minimum of 60g/L sodium hydroxide.', false, '', '', 'C2001960L20', 'Automatic Glasswasher Liquid', 'Automatic Glasswasher Liquid');
INSERT INTO public.chemsapp_product VALUES (505, 'Attack', 'documents/ATTACK.jpg', '', '', 'Spray onto the vehicle at a 1:40 dilution for heavy soil and road film. Light soiling or manual cleaning 
use at 1:100 dilution. 
Apply at low pressure and allow a few minutes before removing thoroughly with fresh water at high 
pressure. Give vehicle a final top to bottom rinse. 
For high pressure water units refer to units instruction manual for dilution rates. 
If streaking occurs, reduce solution concentration', 'FK-ATTA05', 'Kemsol', 'documents/Attack_-_PI.pdf', 'documents/KEMSOL_-_Arctec_-_SDS.pdf', 72, 'A heavy-duty fleet cleaner designed to remove exhaust deposits, road film and bug residue from vehicle surfaces. It contains a unique soil release agent that releases the negative charge that adheres dirt to surfaces, thus enabling better and easier cleaning on subsequent applications.', false, '', '', 'FK-ATTA20', 'Fleet Cleaner', 'Fleet Cleaner');
INSERT INTO public.chemsapp_product VALUES (413, 'Beerline Cleaner', 'documents/Beerline_5L.jpg', '', '', 'WARNING: Causes severe burns to eyes and skin.
Avoid contact with skin and eyes. Protect eyes and wear gloves when handling.
1. Flush all beer from system.

2. Add BEERLINE CLEANER to water to make a 2% solution, for example, 200mL BEERLINE CLEANER to 10L of water.

3. Recirculate the solution through the lines for at least 20 minutes at a velocity of at least 1.5 metres per second. In an 8mm diameter line a 1.5m/s velocity can be achieved by pumping at 4.5L per minute.

4. When equipment cannot be cleaned by recirculating we recommend soaking for at least 30 minutes in 2% BEERLINE CLEANER to loosen soil. Check that all soiling is removed by the rinse water.

5. Rinse to ensure no residues of BEERLINE CLEANER remain.', 'C2110600L05', 'Caskade', 'documents/Beerline_PI.pdf', 'documents/CASKADE_BEER_LINE_CLEANER_SDS.pdf', 72, 'Beerline Cleaner is a high strength, brewery approved, alkaline detergent to rapidly breakdown Beerline soiling. May also be used as a general high-alkaline cleaner for general area cleaning of floors, walls, benches at suitable operator specified dilution rate. Can also be used for cleaning hard-to-remove soiling of processing vessels, and heavy duty cleaning of hard surfaces in general.', false, '', '', 'C2110500L200', 'Brewery Approved • Non-Foaming Alkaline Detergent', 'Low Foam Cleaner');
INSERT INTO public.chemsapp_product VALUES (414, 'Express Sani', 'documents/1656299965.721.jpeg', 'documents/Spray_Surface_Icon_PrC3vKk.png', '', 'For cleaning: General area and equipment cleaning and basic biostatis use at a ratio of 1:50', 'FK-ESAN05', 'Kemsol', 'documents/414_Express_Sani_info_sheet.pdf', 'documents/414_Express_Sani_sds_sheet.pdf', 61, 'Express Sani', false, 'Detergent Sanitiser', 'Purple', '', 'Detergent Sanitiser ', 'Detergent Sanitiser');
INSERT INTO public.chemsapp_product VALUES (415, 'Sudzee', 'documents/Rapid_Sudzee_5L.jpg', 'documents/Dishwash_Liquid_Icon_kEAXdVm.png', '', 'LIGHT WASH UP - Add 50ml per 20 litres of hot water.
