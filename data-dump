INSERT INTO public.chemsapp_product VALUES (488, 'Ultimo 6. Glass & Stainless Cleaner', 'documents/Ultimo_6_-_Glass_and_Stainless_Cleaner.jpg', '', '', 'Use one dose from Ultimo Dispenser per bottle or bucket. Use a mop or spray on to surfaces to be cleaned. Rinse all food contacting surfaces with potable water after use.', 'ULTIMO6', 'Geller', 'documents/I183_No6_Glass_Stainless_PI.pdf', 'documents/Ultimo_6_Glass__Stainless_Steel_Cleaner_SDS.pdf', 55, 'Ultimo 6. Glass and Stainless Cleaner can be used as a spray cleaner for windows, glass
