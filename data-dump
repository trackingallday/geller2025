INSERT INTO public.chemsapp_product VALUES (660, 'Grill Plus', 'documents/Grill_Plus_R7Slh8N.jpg', 'documents/Grill_Plus.jpg', '', 'Apply the product undiluted to warm (not hot) surfaces, spreading it evenly. Do not atomise the product, and never store it in unmarked bottles or open containers. Allow the product to sit for a few minutes, then wipe the surface with an absorbent cloth. For food-contact surfaces, ensure to rinse thoroughly with potable water. For stubborn carbon deposits, use a scraper or abrasive griddle pad to facilitate removal. Repeat application and agitation if necessary until all soiling is completely removed -Do not use on aluminium, zinc, linoleum, chrome, painted, or varnished surfaces. Avoid mixing with acids or other chemicals.

