INSERT INTO public.chemsapp_product VALUES (32, 'Handy Jan', 'documents/HandyJan_P0I6kVt.jpg', '', 'Please contact us to get a copy of our Product Information Sheet', 'Apply product directly to surface or onto a damp cloth or sponge, allowing it to penetrate and lift dirt. Wipe away the loosened grime, using a scrubber if needed for stubborn, ingrained dirt. For best results, work in small sections. Rinse thoroughly with clean water to reveal a spotless, shiny finish. Avoid prolonged contact with delicate surfaces, and always test on an inconspicuous area first.

