INSERT INTO public.chemsapp_product VALUES (201, 'Sodium Metabisulphite', '', '', '', 'All equipment should be cleaned (foreign matter scrubbed off) prior to sanitising. Dissolve 1 – 2 teaspoons (6 – 12 grams) of metabisulfite per litre of water, depending on the sanitising strength desired. Ensure that all equipment is in contact with the solution, or if sanitising a fermenter, that the fermenter is sealed and all surfaces have been regularly contacted by the solution. Contact time of 15 minutes is recommended. Drain all solution and rinse equipment/surfaces with cool boiled water. Your equipment is ready to use immediately.', 'CSMB25', 'Other', '', 'documents/zsmetab_-_sodium_metabisulphite.pdf', 61, 'Used as food preservative and as a source of sulphur dioxide.', false, '', '', '', '', '');
