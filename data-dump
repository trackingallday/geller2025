INSERT INTO public.chemsapp_product VALUES (24, 'Oxy Clean', 'documents/Oxy.jpg', '', 'Please contact us to get a copy of our Product Information Sheet', 'Oxy Clean can be added to your washing machine as part of the normal cycle, or it can be used as a pre-soak in a laundry tub or plastic bucket. Oxy Clean is most effective in a warm 
