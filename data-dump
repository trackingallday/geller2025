INSERT INTO public.chemsapp_product VALUES (489, 'Ultimo 7. Quat Sanitiser', 'documents/Ultimo_7_-_Multi_Quat_Sanitiser.jpg', '', '', 'Use one dose from Ultimo Dispenser per bottle or bucket. Use a mop or spray on to surfaces to be cleaned. Rinse all food contacting surfaces with potable water after use.', 'ULTIMO7', 'Geller', 'documents/I183_No7_MultiQuat_PI.pdf', 'documents/Ultimo_7_Multi_Quat_Sanitiser_SDS.pdf', 55, 'Ultimo 7. Multi Quat Sanitiser is a chlorine free, non-perfumed, high performance quaternary
based sanitiser. Can be used safely on all hard surfaces without the need of rinsing.', true, '', '', '', 'Ultra Concentrate', '');
INSERT INTO public.chemsapp_product VALUES (490, 'Ultimo 8. Medicshield', 'documents/Ultimo_8_-_Medicshield.jpg', '', '', 'Use one dose from Ultimo Dispenser per bottle or bucket. Use a mop or spray on to surfaces to be cleaned. Rinse all food contacting surfaces with potable water after use.', 'ULTIMO8', 'Geller', 'documents/I183_No8_MedicShield_PI.pdf', 'documents/Ultimo_8_Medicshield_Hospital_Grade_Disinfectant_SDS_.pdf', 55, 'Ultimo 8. MedicShield is a hard surface cleaner and sanitiser that is proven to be effective
against a range of bacteria, fungi and viruses that can cause disease especially in those that are in
a weakened state.', true, '', '', '', 'Ultra Concentrate', '');
INSERT INTO public.chemsapp_product VALUES (494, 'Wizzard', 'documents/Wizzard.png', '', '', 'Spray or brush undiluted on hard-surfaces to be cleaned, with care to mimimise atomised product. Leave for
a few minutes. Repeat if required and/or brush-agitate until the soiling is fully removed', 'FK-WIZ05', 'Kemsol', 'documents/C6581_Kemsol_Wizzard_Grill_Oven_Cleaner.pdf', 'documents/KEMSOL_-_Wizzard_-_SDS.pdf', 72, 'Heavy-duty caustic-based cleaner that rapidly cuts through greases, fats and oils. Breaks down heavy food
and cooking build-up to leave pots, pans, utensils, oven tops and equipment looking new. Formulated for
industrial and commercial use. May tarnish aluminum surfaces.', false, '', '', 'FK-WIZ05 | 
FK-WIZ20 |', 'Grill & Oven Cleaner', 'Grill & Oven Cleaner');
INSERT INTO public.chemsapp_product VALUES (495, 'Quat Hi-Foam', 'documents/Quat-Hi-Foam.png-460x460.jpg', '', '', 'For most general food plant foaming applications connect to foaming unit and adjust air/water pressure
and detergent feed until the desired foam density is achieved. Cover surfaces and equipment with foam and allow 5-10 minutes for a full sanitising process to take effect.
For manual cleaning use at a ratio of 1:99 to 1:49 (1-2% soln, 10-20mls per litre) with potable water', 'FK-QUAHI05', 'Kemsol', 'documents/C6045_Kemsol_Quat_Hi-Foam_Cleaner_Sanitiser.pdf', 'documents/KEMSOL_-_Quat_Hi-Foam_-_SDS.pdf', 72, 'A high strength foaming cleaner combined with a quaternary-based sanitiser. Use with or without a foam gun for foaming applications to cleanse and sanitise. Ideal where large areas need to be cleaned at once.', false, '', '', 'FK-QUAHI05 | 
FK-QUAHI20 |', 'Foaming Cleaner & Sanitiser', 'Foaming Cleaner & Sanitiser');
INSERT INTO public.chemsapp_product VALUES (496, 'Agent-Oxy', 'documents/agent-oxy-5kg.png-460x460.jpg', '', '', 'CONCRETE/TILED SURFACES: Dissolve 5 scoops into a plastic bucket with 5 litres of hot water. Allow the 
solution to sit for approx 3-5 mins then evenly pour directly over surfaces. Leave for 2 mins to activate then 
scrub with a brush or stiff broom, adding more solution to surfaces as required. Rinse well and allow to dry.
WOODEN DECKS/SURFACES: Use the same process as above, however a more even coverage may be 
achieved with the use of a plastic watering can, while also reducing product wastage through gaps in decking 
timber. AGENT-OXY may be used with spray equipment, as long as product is completely dissolved. Always 
rinse or wash areas with fresh water to finish. While AGENT-OXY should not cause any damage to plants, 
foliage or animal life, always immediately rinse the product off with fresh cold water. AGENT-OXY is designed 
for ‘best use’ with hot water, above 50-60°c and it will foam up on application', 'FK-AGOX04', 'Kemsol', 'documents/Agent-Oxy_-_PI.pdf', 'documents/KEMSOL_-_Agent-Oxy_-_SDS.pdf', 21, 'Exterior surface powder concentrate, suited to cleaning and rejuvenating exteriors surfaces in particular wooden decks, and other semi-porous surfaces such as concrete driveways and those confronted with organic soiling. Non-caustic, non-chlorinated and non-acidic. Safely removes stains and soiling.', false, '', '', 'FK-AGOX10', 'Multi-Purpose Cleaning Powder', 'Multi-Purpose Cleaning Powder');
INSERT INTO public.chemsapp_product VALUES (497, 'Action', 'documents/Action_Kemsol.jpg', '', '', 'For domestic washing, use at 6-8gm per kg* For commercial washing, use at 10-12gm per kg* For greasy overalls, use at 15-25g per kg* *per kg: dry weight of laundry', 'FK-ACTLA09P', 'Kemsol', 'documents/C5557_Kemsol_Action_18861dbc-4865-4329-8281-ad5444b7797b.pdf', 'documents/KEMSOL_-_Action_-_SDS.pdf', 72, 'Powerful low suds concentrate laundry detergent containing a blend of biodegradable surfactants, lemon fragrance and optical brighteners to give clean and bright wash results. Septic tank safe, when used as directed.', false, '', '', 'FK-ACTLA10', 'Concentrated Laundry Powder', 'Concentrated Laundry Powder');
INSERT INTO public.chemsapp_product VALUES (498, 'Big Kong', 'documents/BIG_KONG.jpg', '', '', 'Use undiluted. Apply preferably with a foaming sprayer to allow extended contact time. 
Leave for a few minutes to for soiling penetration. Waterblast or rinse off with fresh water 
to trade waste', 'FK-BIGKO20', 'Kemsol', 'documents/Big_Kong_-_PI.pdf', 'documents/KEMSOL_-_Big_Kong_-_SDS.pdf', 72, 'Solvent-based degreaser developed for fast cleaning of engines, engine parts, workshop surfaces and grease spots.', false, '', '', 'FK-BIGKO200', 'Engine & Parts Degreaser', 'Engine & Parts Degreaser');
INSERT INTO public.chemsapp_product VALUES (499, 'Bio Urinal Blocks', 'documents/BIO_URINAL_BLOCKS.jpg', '', '', 'Suitable for use in washrooms and toilets with offensive odour problems or slow draining/blockage problems.
Place one block in each individual urinal, or one every 50cm in trough urinals. Replace when the block has 
dissolved to maintain ongoing efficiency. For optimal odour control around urinals, troughs and washrooms,
spray the surrounding surfaces with KEMSOL Bacman and leave to dry.', 'BI-BIOUB04', 'Kemsol', 'documents/Bio_Urinal_Blocks_KG10_-_PI.pdf', 'documents/Bio_Urinal_Blocks_KG10_-_PI_YmTSoVd.pdf', 72, 'Bio Urinal Blocks have been designed for use primarily in urinals to clean and deodorise. They introduce microbes
which consume odour-causing bacteria. They help to breakdown the build-up of uric salts that constrict the flow of
wastewater through pipes.', false, '', '', '', 'Deodoriser and Sanitiser', 'Deodoriser and Sanitiser');
INSERT INTO public.chemsapp_product VALUES (500, 'Alka 600', 'documents/ALKA_600.jpg', '', '', 'Dissolve at a ratio of 10-50g/litre with cold or hot water for cleaning vats and pipes in C.I.P. applications, or as 
required, depending on soiling levels and specific applications. 
If mixing as a solution in a bucket always add to water slowly. Never add water to bulk powder, this product is 
caustic and may react violently.', 'FK-ALKA60020', 'Kemsol', 'documents/Alka_600_-_PI.pdf', 'documents/KEMSOL_-_Alka_600_-_SDS.pdf', 72, 'An effective cleaner for vats and pipes when cleaning in place and as a heavy duty alkaline cleaner for cookers,
hoppers, general equipment and floors.', false, '', '', '', 'Heavy-Duty Alkaline Detergent', 'Heavy-Duty Alkaline Detergent');
INSERT INTO public.chemsapp_product VALUES (501, 'Alpine', 'documents/ALPINE.jpg', '', '', 'Spray undiluted with atomising spray bottle or applicator bottle into the air in rooms containing odours or 
directly at the source of the odour if possible. Instantly reacts with noxious odours to leave the atmosphere 
with a fresh, long lasting fragrance.', 'FK-ALPINE05', 'Kemsol', 'documents/Alpine_-_PI.pdf', 'documents/KEMSOL_-_Alpine_-_SDS.pdf', 72, 'A two-stage action, powerful odour neutraliser which rapidly attacks and neutralises odour molecules while leaving a lingering fresh scent. Ideal for controlling a wide range of malodours including decaying garbage, cooking odours, smoke, animals, body odours and for use in bathroom/toilet areas.', false, '', '', 'FK-ALPINE20', 'Commercial Strength Deodorising Agent', 'Commercial Strength Deodorising Agent');
INSERT INTO public.chemsapp_product VALUES (502, 'Anti-Bac Foam', 'documents/anti-bac-foam-5lt.png-460x460.jpg', '', '', 'Apply directly to hands from dispenser. Lather well and rinse. Repeat if required. Research shows the best 
anti-bacterial action results from hands being lathered and rinsed for at least 20 seconds.', 'FK-ABF05', 'Kemsol', 'documents/Anti-bac_Foam_-_PI.pdf', 'documents/KEMSOL_-_Anti-Bac_Foam_-_SDS.pdf', 72, 'Produces a smooth, creamy lather that cleans hands thoroughly without drying them out. Contains antibacterial agents to assist reducing harmful pathogens on hands. Also has skin conditioning properties.', false, '', '', 'FK-ABF20', 'Antimicrobial Foaming Hand Soap', 'Antimicrobial Foaming Hand Soap');
INSERT INTO public.chemsapp_product VALUES (503, 'Aquasoft', 'documents/AQUASOFT.jpg', '', '', 'Light soiling use at 30-45mls per standard laundry load.*
Medium soiling at 50-65mls.
Heavy soiling at 70-100mls.', 'FK-AQUA05', 'Kemsol', 'documents/Aquasoft_TC12_-_PI.pdf', 'documents/Aquasoft_TC12_-_PI_gWjAtpU.pdf', 72, 'Heavy-duty laundry detergent that leaves clothes clean, bright and fresh. Effective in both hot and cold water. Suitable for use in top or front loaders.', false, '', '', 'FK-AQUA20', 'Concentrated Liquid Laundry Detergent', 'Concentrated Liquid Laundry Detergent');
INSERT INTO public.chemsapp_product VALUES (508, 'Bac-Man', 'documents/BAC-MAN.jpg', '', '', 'Spray undiluted directly (preferably daily) onto surfaces, leave for 5-10 minutes then wipe off with a clean 
cloth or paper towel. May be used safely on all modern surfaces, however, to ensure compatibility with the 
expanding variety of new surfaces it is advisable to always spot-test in an inconspicuous area. 
May be regularly sluiced or wet mopped for hard floors at a ratio of 1:50 (2% solution, 20ml per litre) with 
potable water. Septic tank safe, when used as directed.', 'BK-BACMA01', 'Kemsol', 'documents/Bac-Man_-_PI.pdf', 'documents/KEMSOL_-_Bac-Man_-_SDS.pdf', 72, 'Soil activated cleaning agent for assisting control odours and soiling in a wide variety of ‘difficult to clean’ areas such as non-sealed tiles, grout and lino surfaces. Excellent as a daily control treatment for urinals and toilet areas. Utilises a proprietary blend of environmentally friendly surfactants and active bacterial agents.

Safe regular-use dilutable floor cleaner that over time can provide miraculous results to surfaces engrained with heavy soiling of porous or semi-porous floors like concrete, vinyl and synthetic membrane flooring systems.', false, '', '', 'FK-BACMA05', 'Active Bacterial Cleaning Agent', 'Active Bacterial Cleaning Agent');
INSERT INTO public.chemsapp_product VALUES (509, 'Bac-Stop', 'documents/BAC-STOP.jpg', '', '', 'General hard surface sanitising use at a ratio of 1:100 (10ml per litre, 1% 
soln). 
Foot baths use at a ratio of 1:50 (20 ml per litre, 2% soln). 
Food plant foam sanitising use at a ratio of 1:100 (10ml per litre, 1% soln). 
Mould and mildew control use at a ratio of 1:20 - 1:5 (50-200ml per litre, 
5-20% soln)
May also be used to sanitise open work surfaces such as work tables 
that contact food, providing these can be rinsed and drained completely, 
in order to prevent pooling of detergent residues. Because the product 
contains QAC sanitiser, do not use as a Clean-In-Place (CIP) cleaner 
for enclosed systems, because pooling in such systems may lead to 
contamination by detergent residues.
Used as directed, BAC-STOP will yield a near 100% kill of Salmonella 
typhimurium, Salmonella typhosa, Escherichia coli, Streptococcus 
ssp, Staphylococcus aureus, Saccharomyces cerevisiae, Pseudomonas 
aeruginosa, Proteus vulgaris, Listeria monocytogenes, Bacillus subtilis, 
Candida albicans, Aspergilus niger and most ‘wild’ yeasts within a few 
minutes. Good soil tolerance.', 'FK-BAC05', 'Kemsol', 'documents/Bac-Stop_FP08_-_PI.pdf', 'documents/KEMSOL_-_Bac-Stop_-_SDS.pdf', 72, 'Highly efficient, broad spectrum, cationic germicide. Specifically developed for post-clean disinfection of machines, floors and walls in food processing plants and other areas that require disinfecting.', false, '', '', 'FK-BAC20', 'Sanitiser & Disinfectant', 'Sanitiser & Disinfectant');
INSERT INTO public.chemsapp_product VALUES (510, 'Bac-Tech', 'documents/BAC-TECH.jpg', '', '', 'Clean the surface to be disinfected. Dilute up to a 2% solution with water. Waterblast (preferably with a foaming nozzle) 
or brush on machine or surface to be disinfected. Leave for 10 minutes for disinfection to take place. Rinse off with water. 
May be used at 1:200 dilution as a ‘no-rinse’ sanitiser in fish processing applications.
Used as directed, will yield a near 100% kill of Eschericha coli, Legionella pneumophila, Listeria monocytogenes, 
Pasteurella multocida, Pseudomonas aeruginosa, Salmonella enteritidis, Salmonella typhi, Salmonella typimurium, 
Staphlococcus aureus (MRSA), Staphlococcus aureus - Vancomycin, Staphlococcus epidermidis, Streptococcus 
Enterococcus) faecalis, Hepatitis B (HBV), Hepatitis C (HCV), Herpes Simplex Typelez, Aspergillus niger, and Candida 
albicans within 10 minutes.', 'FK-BACT05', 'Kemsol', 'documents/Bac-Tech_FP16_-_PI.pdf', 'documents/KEMSOL_-_Bac-Tech_-_SDS.pdf', 72, 'Twin chain quaternary liquid cationic germacide developed for the disinfecting of food production plants, including machines, floors, walls, all food premises and any other area that requires disinfecting.nnUsed as directed, will yield a near 100% kill of Eschericha coli, Legionella pneumophila, Listeria monocytogenes, Pasteurella multocida, Pseudomonas aeruginosa, Salmonella enteritidis, Salmonella typhi, Salmonella typimurium, Staphlococcus aureus (MRSA), Staphlococcus aureus - Vancomycin, Staphlococcus epidermidis, Streptococcus Enterococcus) faecalis, Hepatitis B (HBV), Hepatitis C (HCV), Herpes Simplex Typelez, Aspergillus niger, and Candida albicans within 10 minutes.', false, '', '', 'FK-BACT20', 'Twin Chain Quat Sanitiser', 'Twin Chain Quat Sanitiser');
INSERT INTO public.chemsapp_product VALUES (511, 'Ks Beerline Cleaner', 'documents/BEERLINE_CLEANER.jpg', '', '', 'Ensure beerlines are clear from debris and product by rinsing through with warm or cold water. 
Circulate a 1% beerline cleaner and freshwater solution through lines for 10-20 minutes. 
Rinse to trade waste in accordance with local regulations. 
Thoroughly rinse lines again prior to re-filling with product', 'FK-BEERCL05', 'Kemsol', 'documents/Beerline_Cleaner_-_PI.pdf', 'documents/KEMSOL_-_Beerline_Cleaner_-_SDS.pdf', 72, 'Non-chlorinated high strength, brewery approved, alkaline detergent to rapidly breakdown beerline soiling. May also be used as a general high-alkaline cleaner for general area cleaning of floors, walls, benches at suitable operator specified dilution rate. Can also be used for cleaning hard-to-remove soiling of processing vessels, and heavy-duty cleaning of hard surfaces in general.', false, '', '', 'FK-BEERCL20', 'Low Foam Cleaner', 'Low Foam Cleaner');
INSERT INTO public.chemsapp_product VALUES (512, 'Fast Fleet', 'documents/FAST_FLEET.jpg', '', '', 'Concentrate: To make 200L of concentrated cleaner, add 20L of concentrate to 180L of clean cold 
water (dilution rate of 1:9). Application: Further dilute solution 1:40 for cleaning to use manually with 
a bucket and brush, or through a waterblaster or other automatic dilution unit (making a final ratio of 
1:409). Rinse vehicle thoroughly to finish. Dry surfaces with a clean dry microfibre cloth or chamois for 
maximum shine. Avoid washing in direct sunlight', 'FK-FASTF02', 'Kemsol', 'documents/Fast_Fleet_-_PI.pdf', 'documents/fastfleet20_sds.pdf', 72, 'A super-concentrated vehicle cleaning agent. Fast Fleet is biodegradable and leaves vehicles brilliantly clean with a showroom shine.', false, '', '', 'FK-FASTF20', 'Concentrate Vehicle Cleaner', 'Concentrate Vehicle Cleaner');
INSERT INTO public.chemsapp_product VALUES (513, 'Bio-Gt', 'documents/BIO-GT.jpg', '', '', 'Grease traps: Add 1Ltr initially, then either manually or auto-dose 100ml per day, at the completion of daily 
activity directly to grease trap entry port or down the drain hole.
Odour control: Spray directly onto affected areas at a ratio of 1:10-1:50 with fresh water. 
Septic tanks: Charge system with 4Ltrs, and then add 500ml weekly for every 4 people using the system', 'BI-BIOGT5', 'Kemsol', 'documents/Bio-GT_FS21_-_PI.pdf', 'documents/KEMSOL_-_Bio-GT_-_SDS.pdf', 72, 'A unique blend of active non-pathogenic enzymes to clean grease traps, treat septic tanks and combat bad odours. Suitable for food service, process operations and general commercial use.', false, '', '', '', 'Biological Wastewater & Grease Trap Treatment', 'Biological Wastewater & Grease Trap Treatment');
INSERT INTO public.chemsapp_product VALUES (514, 'Blick', 'documents/BLICK.jpg', 'documents/Glass_Cleaner_Icon.png', '', 'Use sparingly and spray on undiluted, then wipe with a dry, clean, lint free cloth. May be used at a ratio of 
1:20 (5% solution, 50ml per litre) with potable water for squeegee window cleaning applications. 
Always aim to minimise airborne product', 'FK-BLICK05', 'Kemsol', 'documents/Blick_-_PI.pdf', 'documents/KEMSOL_-_Blick_-_SDS.pdf', 72, 'Ideal for commercial and domestic glass, mirrors, tiles and chrome cleaning. Quick drying and streak free. Helps inhibit resoiling and finger prints.', false, '', '', 'FK-BLICK20', 'Glass Cleaner', 'Glass Cleaner');
INSERT INTO public.chemsapp_product VALUES (515, 'Blitz', 'documents/BLITZ.jpg', '', '', 'Apply undiluted using a damp cloth or sponge. While the abrasive is fine-grade, prolonged use on plastic, 
painted or laminated surfaces is not recommended', 'FK-BLITZCTN', 'Kemsol', 'documents/Blitz_HK05_-_PI.pdf', 'documents/KEMSOL_-_Blitz_-_SDS.pdf', 72, 'Powerful heavy-duty cleansing agent with a fine natural abrasive. Ideal for cleaning kitchen and bathroom surfaces without harsh scratching. Septic tank safe, when used as directed.', false, '', '', 'FK-BLITZ05', 'Natural Abrasive Cream Cleanser', 'Natural Abrasive Cream Cleanser');
INSERT INTO public.chemsapp_product VALUES (516, 'Tussel', 'documents/CASKADETUSSELDOSEDLAUNDRYBUILDER20L_560x420c0pcenter.jpg', '', '', 'Ensure all dosing lines are clean before placing into Tussel containers - rinse thoroughly with water if lines are contaminated with other chemicals, dirt or crystals.', 'C2063430L20', 'Caskade', 'documents/Tussell_PI.pdf', 'documents/CASKADE_TUSSEL_2021.pdf', 72, 'Tussel provides high performance alkalinity for liquid dosed laundry systems.
Tussel is effective at low temperatures to allow for energy conserving cold or warm wash cycles moreover Tussel ‘s concentrated solvent-free formulation enhances the ability to be reliably dosed and thus minimise wastage.
Tussel’s powerful chelating ability is effective in the wash and at rinse pH ranges to ensure metallic contaminants are removed from the work during rinse cycles. Complete removal of chelated contaminants maintains original colours longer and minimises yellowing.', false, '', '', 'C2063430L200', 'Dosed Liquid Laundry Builder', '');
INSERT INTO public.chemsapp_product VALUES (517, 'Supreme', 'documents/Supreme_20L.jpg', '', '', 'Ensure all dosing lines are clean before placing into Supreme’s container - rinse with water or weak bleach if lines are contaminated with other chemicals or dirt. Protect skin and eyes from potential splashes.', 'C2063390L020', 'Caskade', 'documents/Supreme_PI.pdf', 'documents/CASKADE_SUPREME_SDS_2021.pdf', 72, 'Supreme provides high performance detergency for liquid dosed laundry systems. It is effective at low temperatures to allow for energy conserving cold or warm wash cycles moreover Supreme’s concentrated solvent-free formulation enhances the ability to be reliably dosed and thus minimise wastage.
Supreme is a clear slightly fluorescent liquid essentially free from hazards. Its pH is held between 5.5 to 6.0 for personal safety. This near neutral formula contains effective anti-redeposition and optical brightening agents to prevent greying and safely increase fabric brightness.', false, '', '', 'C2072940L05
C2063410L200', 'Dosed Laundry Detergent', '');
INSERT INTO public.chemsapp_product VALUES (518, 'Citrus Multi Cleaner', 'documents/Jasco_-_Citrus_Multi.jpg', '', '', 'Depending on application, 1 x 5ltr of Citrus Multi can be diluted up to 1:80 = (approx 12.5ml per litre of water) making over 400 litres of ready to use product.', 'JBCIT5', 'Hygienic', 'documents/Citrus_Clean_PI_GdKCmje.pdf', 'documents/CASKADE_CITRUS_CLEANER_SDS_g254xyK.pdf', 72, 'Citrus Multi is a powerful D-Limonene based natural universal cleaner derived from citrus fruits. Formulated with a blend of biodegradable surfactants for the effective removal of organic based soiling, grease, fat and other dirt and grime. Because of the high dilution rate, Citrus Multi can also be used for heavy duty degreasing and removal of other soils including oils, waxes, body fats, soap scum and carbons. Can also be used as a heavy duty truck wash, or exterior building wash, etc. Citrus Multi can used selectively for carpet and laundry spotting.
 MPI Approved C31 (all animal product except dairy)', false, '', '', '', 'Citrus Based Cleaner and Degreaser', '');
INSERT INTO public.chemsapp_product VALUES (519, 'Dyna Brite', 'documents/Jasco_-_Dyna_Brite.jpg', '', '', 'Light soiling use at 30-45mls per standard laundry load*
Medium soiling at 50-65mls
Heavy soiling at 70-100mls
*Standard laundry load is approximately 4-5kg dry-weight laundry. Ensure solution is thoroughly rinsed from garments prior to drying.', 'TALLD5', 'Hygienic', 'documents/II049_Dyna_Blue_PI.pdf', 'documents/Geller_DynaBlue_Laundry_Liquid_MSDS.pdf', 72, 'A premium commercial liquid laundry detergent with advanced active ingredients to remove the heaviest of soiling. Includes water sequestering and soil suspension agents, optical whiteners & brighteners. Safe on all fabrics including synthetics and woollens.', false, '', '', '', 'Liquid Laundry Detergent', '');
INSERT INTO public.chemsapp_product VALUES (520, 'Blue Quell', '', '', '', 'Add to holding tank at a ratio of 1:10 to 1:100 with fresh water depending on frequency of use. 
For extended use, use double dosage.
Heavy dye content may cause staining on textiles and some hard surfaces.
Contains no formaldehyde or glutaraldehyde', 'FK-QUELL05', 'Kemsol', '', '', 72, 'Containing a unique blend of bactericides and odour neutralisers, this easy to use ‘2 in 1’ formula neutralises bacteria activity and odours in portable toilets.', false, '', '', '', 'Portable Toilet Chemical', 'Portable Toilet Chemical');
INSERT INTO public.chemsapp_product VALUES (521, 'Blue Rhino', '', '', '', 'For usual medium duty cleaning use at a ratio of 1:50 (2% solution, 20mls per litre) with potable water. For spray and wipe applications use at a ratio of 1:25 (4% solution, 40ml per litre). For heavy duty cleaning use at a ratio of 1:9 (10% solution, 100ml per litre). High Pressure cleaning, dilute 1:100 - 1:200. Rinse with water after use.', 'FC-BLURHN200', 'Kemsol', '', '', 72, 'Multipurpose cleaner degreaser that can be used in a range of commercial and industrial applications. Suitable for cleaning a wide range of hard surfaces including floors, benches, tiles, bathrooms, showers, basins etc. Suitable for removing oil, grease and carbon soiling and dust from concrete floors and for use through high-pressure water blasters for washing exterior surfaces.', false, '', '', '', 'heavy-duty Cleaner Degreaser', 'heavy-duty Cleaner Degreaser');
INSERT INTO public.chemsapp_product VALUES (522, 'Blue Strike', '', '', '', 'Domestic Washing use at 8-10g per kilo of dry-weight laundry.
Commercial Washing use at 12-15g per kilo of dry-weight laundry.
Greasy Overalls use at 20-40g per kilo of dry-weight laundry.
Ensure solution is thoroughly rinsed from garments prior to drying.', 'FK-BLUSTRP10', 'Kemsol', '', '', 72, 'Economical, low foam laundry powder that contains biodegradable surfactants for removing stains and optical brightening agents to enhance appearance of fabrics. Suitable for use in hot or cold water, in top or front loaders.', false, '', '', '', 'Laundry Powder', 'Laundry Powder');
INSERT INTO public.chemsapp_product VALUES (523, 'Bowl Patrol', '', '', '', 'Flush toilet, then squirt a liberal amount around the top of the bowl, beginning up under the rim to allow 
the product to cover all surfaces, and run down the surface. Can be immediately scrubbed if needed, but 
recommended to leave for 4-5 minutes to allow dwell-time to soften and release soiling. Flush to finish. 
Repeat if required. 
When diluted at 1:4 with water BOWL PATROL is an excellent heavy-duty shower cleaner and an ideal 
anti-bacterial spray and wipe product. Great on stainless steel', 'FK-BOWL05', 'Kemsol', '', '', 72, 'Cleaner and combined disinfectant designed specifically for toilet bowl applications. Excellent for cleaning urinals and stainless steel surfaces too. Formula viscosity specifically designed for bowl-cling to minimise scrubbing. Septic tank safe, when used as directed.', false, '', '', '', 'Disinfects and Deodorises Toilet Bowls', 'Disinfects and Deodorises Toilet Bowls');
INSERT INTO public.chemsapp_product VALUES (524, 'Bright Wash', '', '', '', 'For commercial automatic glasswash machines inject via an automatic pump at a ratio of 1:500 (0.2% 
solution, 2ml per litre) with potable wash water. 
Warewash units use at a ratio of 1:250 (0.4% solution, 4mls per litre) of potable wash water. 
Use in conjunction with KEMSOL RINSE AID for optimum performance. 
If used as a soaking agent, use at a ratio of 1:1 with potable water, and soak for a time period suitable for the 
results desired. Prior testing of surface suitability for soaking application is recommended', 'FK-BRIWA05', 'Kemsol', '', '', 72, 'Concentrated non-caustic auto-dish and glass wash detergent. An ideal safer alternative to traditional caustic based formulations. Unique formulation suitable on wide range of surfaces - cutlery, crockery, china, stainless steel and plastic/synthetic items. May be used also as a safer heavy-duty soaking agent for aluminium components. Septic tank safe when used as directed.', false, '', '', '', 'Non-Caustic Auto-Dish and Glass Washing Liquid', 'Non-Caustic Auto-Dish and Glass Washing Liquid');
INSERT INTO public.chemsapp_product VALUES (525, 'Carpet Spotter', '', '', '', 'spray on soiled area. Leave for a few minutes. Shampoo off or remove with a damp sponge.
Always try on an inconspicuous area before use.', 'BK-CARPSOL', 'Kemsol', '', '', 72, 'Powerful spotter for use on individual marks or as a pre-spray prior to shampooing. Excellent on food, oils, fats, general soiling as well as marks and stains on hard surfaces.', false, '', '', '', 'Stain Remover', 'Stain Remover');
INSERT INTO public.chemsapp_product VALUES (526, 'Cherry Bombs', '', '', '', 'Distribute blocks into urinals or place in a container near noxious odour.', ' FK-CHB03', 'Kemsol', '', '', 72, 'Perfume blocks primarily for use in urinals and areas harbouring unpleasant odours. Cherry Bombs contain an effective deodoriser and bactericide.', false, '', '', '', 'Urinal Deodorising & Sanitising Blocks', 'Urinal Deodorising & Sanitising Blocks');
INSERT INTO public.chemsapp_product VALUES (527, 'Chlorosan', '', '', '', 'For all general hard surfaces sanitising use at a ratio of 1:50 (2% soln, 20ml per ltr) with potable cold water. 
Spray or wash machines and surfaces to be sanitised. Leave for 5 minutes then rinse with potable water.', ' FK-CHLOR5
', 'Kemsol', '', '', 72, 'Concentrated, non-caustic cleaner for a wide range of applications. In food processing plants it can be used for cleaning benches, equipment, walls and floors. Also suitable for cleaning exterior surfaces.', false, '', '', '', 'High Strength Sanitiser', 'High Strength Sanitiser');
INSERT INTO public.chemsapp_product VALUES (528, 'Cip 247', '', '', '', 'Dilute CIP 247 at 0.5%(0.5:100) depending on soiling type, at 60-70 degrees celsius, and circulate through 
vessels and piping systems for between 15-60 minutes depending on soiling type. 
Always finish CIP cleaning with a thorough flush, and pH test discharge water to ensure pH is the same as 
supply water source. 
For hard surface clean dilute 1% to 5%.', 'FK-CIP20', 'Kemsol', '', '', 72, 'Powerful, low-foam, alkaline, chlorinated cleaning agent. Ideal for use in CIP, closed-loop cooking systems, vats, pipelines and processing equipment.', false, '', '', '', 'Liquid Caustic Cleaner & Chlorine Sanitiser', 'Liquid Caustic Cleaner & Chlorine Sanitiser');
INSERT INTO public.chemsapp_product VALUES (529, 'Citrus Blast', '', '', '', 'Spray or apply with a cloth directly onto the surface to be cleaned, then wipe clean with a clean rag or cloth. 
In spray-on application, always minimise atomised product by adjusting the spray nozzle. May be applied 
directly to a clean cloth or paper towel, instead of direct-to-surface application. Leave for 30 seconds to 
10 minutes (depending on soiling type and levels), then wipe with clean cloth or paper towel. Repeat if 
required. Longer contact time may prove beneficial for soiling such as graffiti and chewing gum. ', 'FK-CITR05', 'Kemsol', '', '', 72, 'High strength multi-purpose cleaning agent for the removal of tar, rubber marks, graffiti and other heavy soiling from a variety of surfaces. Leaves a lasting citrus fragrance.', false, '', '', '', 'Citrus Based Solvent Cleaner', 'Citrus Based Solvent Cleaner');
INSERT INTO public.chemsapp_product VALUES (530, 'Clin-A-Sept', '', '', '', 'For hard surface treatment for bathrooms, janitorial floors and toilet surfaces use at a ratio of 1: 100 - 1:50 ( 
1 - 2% soln, 10-20mls per litre) to warm or cold potable water. 
For extended use double the recommended dosage.', 'FK-CLIN05', 'Kemsol', '', '', 72, 'Powerful disinfectant for killing germs in a wide range of areas. Ideal for sanitising bathrooms, toilets, laundry, and kitchen areas. Leaves a distinctive fragrance.', false, '', '', '', 'Disinfectant', 'Disinfectant');
INSERT INTO public.chemsapp_product VALUES (531, 'Coffee Machine Kleen
', '', '', '', 'Loose rinse each head with manufacturers blind hopper. Add 1tsp (5gms) to blind hopper.Circulate through 
clean cycle for 15 seconds.Repeat for each coffee machine head.Brew and discard 1 cup per head prior to 
restart', 'FK-COFFKL500G', 'Kemsol', '', '', 72, 'A safe and economical way to remove scale and coffee soiling from inside coffee machine heads. Non-corrosive and non-hazardous.', false, '', '', '', 'Coffee Machine Head Cleaner', 'Coffee Machine Head Cleaner');
INSERT INTO public.chemsapp_product VALUES (532, 'Command', '', '', '', 'Light soiling use at 30-45mls per standard laundry load*
Medium soiling at 50-65mls
Heavy soiling at 70-100mls 
*Standard laundry load is approximately 4-5kg dry-weight laundry. 
Ensure solution is thoroughly rinsed from garments prior to drying.', 'FK-COMLAU05', 'Kemsol', '', '', 72, 'Suitable for use in all domestic and commercial washing top and front loading machines. Contains powerful surfactants and optical brightening agents to enhance fabric appearance. Works well on light, medium and heavy soiling, and is suited to domestic, hotel, motel and on-premise laundry applications. Do not apply directly onto fabric without diluting. Suitable for use in hot or cold water. Septic tank safe, when used as directed.', false, '', '', '', 'Concentrated Laundry Liquid', 'Concentrated Laundry Liquid');
INSERT INTO public.chemsapp_product VALUES (533, 'Cycloscrub', '', '', '', 'For use in an automatic floor scrubber machine use as directed by machine manufacturers instructions. As a 
guide this is generally diluted in the mix tank at approximately 1:50 (2% soln, 20ml per ltr) with potable water. 
May also be used manually for heavy duty floor cleaning at the same dilution rate, or stronger as required.', 'FK-CYCSCR05', 'Kemsol', '', '', 72, 'Caustic based detergent for automatic floor scrubbing machinery. Special low-foam formulation which works well on a wide variety of surfaces. May also be manually diluted for hand-cleaning of concrete floors.', false, '', '', '', 'Floor Scrubbing Detergent', 'Floor Scrubbing Detergent');
INSERT INTO public.chemsapp_product VALUES (534, 'Deodor 30', '', '', '', 'Strong, offensive odours: dilute 1:1 with clean water and spray with a hand pump pack. 
Mild odours: dilute 1:10 - 1:25 with clean water and spray.
To wash down odourous areas: dilute 1:50 - 1:100.
Note: Will work instantly, unless the source of the odour can be identified and removed, subsequent 
applications may be required', 'FK-DEOD3005', 'Kemsol', '', '', 72, 'Concentrated Odour Neutralising Agent for use in industrial and commercial situations. It can be diluted with water or used in its concentrated form. Neutralises offending odours from organic waste, toilet ablution areas, animal waste and renderings and leaves a lingering fragrance.', false, '', '', '', 'Odour Neutralising Agent', 'Odour Neutralising Agent');
INSERT INTO public.chemsapp_product VALUES (535, 'Descale Part A', '', '', '', '1. PVC rubber gloves and wrap around safety glasses essential. 
2. Remove drain bung to drain wash tank. 
3. Turn detergent pump off (if pump is fitted and cannot easily be temporarily disconnected or turned 
off, then detergent must be temporarily replaced with water solution and run for 5 cycles to ensure 
detergent is not injected into machine during procedure). Alternatively a Washtech Serviceman could 
remove front machine cover and temporarily remove feed wire or squeeze tube from the dispenser. 
4. Approximately 1/2 fill main wash tank add Descale A to wash tank at a ratio of 1LTR to every 5LTRS of 
wash water. (i.e. if wash tank is 10LTRS then add 2LTRS of Descale A when tank is 70% full and check 
that chemical is not going down the overflow drain). 
5. Allow tank to completely fill as Rinse Water fills tank.
6. Cycle Machine for 10-15 X 1 minute cycles, checking the softness of the scale as you go. Scale should 
gradually soften. 
7. Agitate with a stiff brush to assist break up scale, as required through wash cycles. 
8. Remove drain bung and empty wash tank solution. 
9. Refill wash tank with fresh water, and circulate for 3 X 1 minute cycles. 
10. Remove drain bung and empty wash tank solution.
11. Never mix with Descale Part B', ' FK-DESA05', 'Kemsol', '', '', 72, 'First part of a two-part cleaning system for descaling and sanitising industrial and commercial dishwashers.', false, '', '', '', 'Scale Softening Agent', 'Scale Softening Agent');
INSERT INTO public.chemsapp_product VALUES (536, 'Exceed', '', '', '', 'For general commercial washing use at 130g per 10kg dry weight laundry. 
For greasy overalls use at 200g per 10kg dry weight laundry. 
Dissolved solution only should be used with any garment cleaning - do not add powder directly to fabrics.', 'FK-EXCEP10', 'Kemsol', '', '', 72, 'Powerful low-suds formulated laundry powder for use on commercially soiled garments such as overalls, floor mats and rags', false, '', '', '', 'Extra Heavy-Duty Laundry Powder', 'Extra Heavy-Duty Laundry Powder');
INSERT INTO public.chemsapp_product VALUES (537, 'Express Sr', '', '', '', 'For normal light duty hard surface and hard surface cleaning dilute with warm or cold potable water at a 
ratio of 1:100 (1% solution, 10ml per litre). 
Medium duty cleaning at a ratio of 1:50 (2% solution, 20ml per litre)
Heavy-duty cleaning, dilute to 1:20 (5% solution, 50ml per litre)', 'FK-EXSR05', 'Kemsol', '', '', 72, 'Heavy-duty cleaner for a wide range of applications; commercial and industrial premise walls, floors, equipment and machine parts. It is especially useful on surfaces soiled with fat or oil. Contains a soil release agent which releases the static electric charge that adheres soiling to a surface, making it an effective first time cleaner, and making subsequent cleanings easier.', false, '', '', '', 'Heavy-Duty Cleaner', 'Heavy-Duty Cleaner');
INSERT INTO public.chemsapp_product VALUES (538, 'Extractol', '', '', '', 'For wet extraction carpet machines use at a ratio of 1:400 to 1:100 (50 - 200mls per 20 ltr wash 
solution tank). 
For spotting on heavily soiled areas dilute at a ratio of 1:3 (25% soln, 250mls per ltr) with potable water', 'FK-EXTRA05', 'Kemsol', '', '', 72, 'Concentrated shampoo for use in carpet machines or for spotting on heavily stained areas. Always test on an inconspicuous area before using. Can be used in hot or cold systems. Safe low-foam formulation providing excellent cleaning results. Septic tank safe when discharged as directed.n', false, '', '', '', 'Carpet Shampoo', 'Carpet Shampoo');
INSERT INTO public.chemsapp_product VALUES (539, 'Fabfresh', '', '', '', 'Mist spray FABFRESH evenly onto the surface of the odourous fabric from a distance of 25cm until slightly 
damp. Odours vanish as FABFRESH dries. Allow a light coating of approximately 10mls per square metre. 
Allow 30 minutes to dry. Reapply for stubborn or pungent odours. Safe on most fabrics. Always test on a 
small area that cannot be seen before using. Not suitable for silk or fabrics that waterspot. ', 'FK-FAB05', 'Kemsol', '', '', 72, 'Non-staining textile fabric odour neutraliser suitable for removing a wide range of inorganic odours from textiles and fabrics. Removes odours from smoke, cooking, alcohol, vomit, pets and mustiness.', false, '', '', '', 'Fabric Deodoriser / Refresher', 'Fabric Deodoriser / Refresher');
INSERT INTO public.chemsapp_product VALUES (540, 'Foam Hands', '', '', '', 'Before sanitising, ensure your hands are clean and dry. Apply directly onto the hands, rub well, ensuring 
whole area of your hands is well covered. Leave to air dry.', ' FK-FOHS05', 'Kemsol', '', '', 72, 'An effective sanitiser in a foam. No need for water or paper towels. Ideal where wash stations are not available. Pump through a foaming applicator or wall dispenser.', false, '', '', '', 'No-Rinse Foaming Hand Sanitiser', 'No-Rinse Foaming Hand Sanitiser');
INSERT INTO public.chemsapp_product VALUES (541, 'Foam Soap', '', '', '', 'Apply a small quantity directly onto hands from the dispenser. Rub hands together for a smooth lather and 
rinse off. Repeat if required.', ' FK-FOS05', 'Kemsol', '', '', 72, 'Produces a smooth, “quick to cover” soft and creamy lather that cleans hands well and keeps them moist and supple. It is a powerful cleaner, yet soft on the hands. It also has skin conditioning properties.', false, '', '', '', 'Perfumed Foaming Hand Soap', 'Perfumed Foaming Hand Soap');
INSERT INTO public.chemsapp_product VALUES (542, 'Foam-Force', '', '', '', 'For most general food plant foaming applications connect to foaming unit and adjust air/water pressure and detergent 
feed until the desired foam density is achieved. Cover surfaces and equipment with foam and allow 5-10 minutes for a full 
sanitising process to take effect. 
For manual cleaning use at a ratio of 1:99 to 1:49 (1-2% soln, 10-20mls per litre) with potable water. Not for use on 
aluminium or soft metals as corrosion or oxidation may quickly occur. 
A 1% solution yields 450 ppm of Free Available Chlorine (when product packed)', 'FK-FOAFO05', 'Kemsol', '', '', 72, 'High-strength plant foaming cleaner and hypochlorite based sanitiser. Best applied through automatic dilution control equipment or a centralised foaming operation for cleaning large plant and equipment areas, typical in food process operations. If used manually, treat with extreme care. See precaution panel.', false, '', '', '', 'Hi-Strength Foaming Cleaner & Sanitiser', 'Hi-Strength Foaming Cleaner & Sanitiser');
INSERT INTO public.chemsapp_product VALUES (543, 'Formula', '', '', '', 'Inject undiluted directly into wash water at a ratio of 2-3mls per litre via an automatic peristaltic pump. Not 
recommended for manual dosing, unless in contingency commercial situations. Use in conjunction with 
KEMSOL RINSE AID for optimum performance', 'FK-FORCO05', 'Kemsol', '', '', 72, 'Concentrated low-foam detergent for automatic, commercial, dish and glass washing machines. Suitable for common materials such as crockery, glass, china, stainless steel and plastic. Not recommended for aluminium and other soft-metal constructed items.', false, '', '', '', 'Automatic Dish and Glass Washing Liquid', 'Automatic Dish and Glass Washing Liquid');
INSERT INTO public.chemsapp_product VALUES (544, 'Gen-Tex', '', '', '', 'Dose at a ratio of 2-4mls per kg of dry laundry.* Apply to second to last wash cycle and follow with a final rinse. 
*Standard laundry load is approximately 4-5kg dry-weight laundry', 'FK-GENTEX05', 'Kemsol', '', '', 72, 'A high strength fabric softening agent designed to be used in automatic laundry systems. Its anti-static properties reduce “clinging” and linting in tumble dryers and increases flat work productivity. Low pH ensures effective reduction of any residual alkalinity.', false, '', '', '', 'Softener & Sour', 'Softener & Sour');
INSERT INTO public.chemsapp_product VALUES (545, 'Glisten', '', '', '', 'Inject undiluted directly into wash water at a ratio of 1-2mls per litre. Use in conjunction with KEMSOL
RINSE AID.', 'FK-GLIS05', 'Kemsol', '', '', 72, 'Powerful, chlorinated, liquid detergent formulated for use in automatic, commercial, dish and glass washing machines. Suitable for glass, china, stainless steel and plastic. It cleans, aids stain removal and sanitises in one action.', false, '', '', '', 'Automatic Dish & Glass Washing Liquid', 'Automatic Dish & Glass Washing Liquid');
INSERT INTO public.chemsapp_product VALUES (546, 'Grease Meister', '', '', '', 'Sprinkle sparingly over floor to be cleaned and spray lightly with water. Scrub surface with stiff broom 
and leave for 5 minutes. Scrub again lightly and rinse or waterblast floor. 
If mixing as a solution in a bucket always add to water slowly. Never add water to bulk powder as this 
product is caustic and may react violently.', 'FK-GREMIE20', 'Kemsol', '', '', 72, 'Powerful degreaser for removing grease and oil soiling from floors.', false, '', '', '', 'Concentrated Powder Degreaser', 'Concentrated Powder Degreaser');
INSERT INTO public.chemsapp_product VALUES (547, 'Green Pine', '', '', '', 'For hard surface treatment for bathrooms, janitorial floors and toilet surfaces use at a ratio of 1: 100 - 1:50 
( 1 - 2% soln, 10-20mls per litre) to warm or cold potable water. For extended use double the recommended 
dosage', 'FK-GRPINEN05', 'Kemsol', '', '', 72, 'Powerful disinfectant with a pine fragrance for bathrooms and toilets. Recommended for the bathroom, toilet or anywhere a high standard of hygiene is required.', false, '', '', '', 'Disinfectant', 'Disinfectant');
INSERT INTO public.chemsapp_product VALUES (548, 'Halo', '', '', '', 'Laundry Applications - 1:20 (5% soln, 50ml per litre). 
Kitchen and Bathrooms - Wet mop or wipe at 1:50 (2% soln, 20ml per litre).
Outdoor Hard Surfaces - 1:5 to 1:1 (20% - 50% soln.
Never use on wool or silk, and not recommended for use on coloured or sensitive garments as streaking, 
fading or other deterioration could result.', 'FK-HALO05', 'Kemsol', '', '', 72, '', false, '', '', '', 'Thickened Bleach', 'Thickened Bleach');
INSERT INTO public.chemsapp_product VALUES (549, 'Haze Off', '', '', '', 'Squirt directly onto glass or onto a white non-scratch pad. Work in a circular motion with a light to moderate 
pressure to evenly cover and clean surfaces. Repeat or add more HAZE OFF as required. Caution should be 
taken not to use excessive pressure which could cause damage to some delicate surfaces. Once surfaces lose 
the ‘furry’ feel and begin to ‘squeak’, cleaning is complete.
All surfaces being cleaned by HAZE OFF should be spot-tested to ensure compatibility', 'FK-HAZO05', 'Kemsol', '', '', 72, 'A user-safe, non-caustic and non-chlorinated shower glass surface cleaner and rejuvenator. Brings ‘scaled’ and calcified surfaces back to near new.', false, '', '', '', 'Shower Water Mark Remover', 'Shower Water Mark Remover');
INSERT INTO public.chemsapp_product VALUES (550, 'Hd-Pro', '', '', '', 'Add HD PRO at a rate of 5 to 10gms per kg dry weight laundry, depending on the degree of soiling.
For heavily soiled garments Kemsol Ultra or Kem-Tex can be used as an additive to boost cleaning results. 
Refer to your Kemsol rep for recommended additive rates. 
Do not add onto dry garments. 
Note: Do not use HD PRO for woollens or delicate fabrics.', 'FK-HDPRO20', 'Kemsol', '', '', 72, 'Grease cutting laundry powder for use on heavily soiled garments such as overalls & floor mats, in particular where food soiling is evident.', false, '', '', '', 'Heavy-Duty Industrial Laundry Compound', 'Heavy-Duty Industrial Laundry Compound');
INSERT INTO public.chemsapp_product VALUES (551, 'Hypo', '', '', '', 'Interior Food Process Hard Surfaces: Use at a ratio of 0.3-0.6% solution for hard surface sanitising.
Vegetable/Fruit Processing Aid: Suitable for low PPM treatment of processed vegetables and fruit where 
sodium hypochlorite is deemed approved for use. Generic MPI Approval. Dosage rates to suit specific 
applications, however as a general guide 20-30PPM (1:100 provides approx. 1500PPM FAC, 1:1000 provides 
approx. 150PPM).
Laundry Stain Removal: Use at 1:200 (0.5%, 5mls per litre). 
Exterior Buildings: Use at a ratio of 1:100 to 1:50 (1-2% solution, 10-20ml per litre) with potable water. 
Swimming Pools: Use at 300mls per 10,000 litres each day and 500mls per 10,000 litres weekly. 
Pool Shock Dose: Use at 1000mls per 10,000 litres of water', 'FK-HYPO05', 'Kemsol', '', '', 72, 'Commercial grade concentrated Sodium Hypochlorite solution containing 150g/litre F.A.C. when packed.', false, '', '', '', '15% Concentrated Chlorine', '15% Concentrated Chlorine');
INSERT INTO public.chemsapp_product VALUES (552, 'Hy-Tex', '', '', '', 'Add to a wash cycle at a ratio of 4-8mls per kg of dry weight laundry. Always dilute before adding to dry washing', 'FK-HYTEX20', 'Kemsol', '', '', 72, 'Stabilised sodium hypochlorite based destainer/sanitiser. Removes stains, maintains whiteness and sanitises. Chlorine compatible surfactants increase the product’s performance by allowing deeper and even penetration of a wide range of textiles. Can bleach dyes from coloured fabrics so always check for garments not suitable for chlorine treatment. If in doubt undertake separate soak test.', false, '', '', '', 'Destainer & Sanitiser', 'Destainer & Sanitiser');
INSERT INTO public.chemsapp_product VALUES (553, 'K1 Glass', '', '', '', 'Dilute 1:50 (2%) with water into spray bottle, spray to surfaces, then wipe with a clean cloth or paper towel.', 'K-UCK1G02L', 'Kemsol', '', '', 72, 'Specially formulated for windows, mirrors and glass surfaces. Designed to be diluted either through automatic dilution equipment, via the use of a multi-dose wall mounted unit, or a plunger device.', false, '', '', '', 'Ultra Concentrate', 'Ultra Concentrate');
INSERT INTO public.chemsapp_product VALUES (554, 'K2 Multi-Surface', '', '', '', 'For floor and general hard surface cleaning use at a ratio of 1:200 (0.5% soln, 5ml per litre) with warm or 
cold potable water. For spray-n-wipe applications use at a ratio of 1:50 (2% soln, 20mls per litre) with cold 
potable water, then apply to surfaces, and wipe with a clean cloth or paper towel.', 'FK-UCK2M02L', 'Kemsol', '', '', 72, 'Ultra Concentrate multipurpose degreaser and hard surface cleaner for benches, walls and floors designed to be diluted either through automatic dilution equipment, via the use of a multi-dose wall mounted unit, or a plunger device.', false, '', '', '', 'Ultra Concentrate', 'Ultra Concentrate');
INSERT INTO public.chemsapp_product VALUES (555, 'K3 Pot & Pan', '', '', '', 'For general manual dishwash applications dilute at a ratio of 1ml to 5 or 10 litres of warm to hot water, 
more or less depending on soiling levels and speed of clean desired. Wash items then stand-dry. Critical 
food-service applications may require an additional sanitising step and/or rinsing prior to re-use', 'FK-UCK3P02L', 'Kemsol', '', '', 72, 'Manual dishwash designed to be used sparingly to kitchen sink and other manual cleaning. Ideal for glasses, utensils, crockery, pots & pans. For best performance use through a Multi-Dose wall mounted unit is recommended. Septic tank safe when used as directed.', false, '', '', '', 'Ultra Concentrate', 'Ultra Concentrate');
INSERT INTO public.chemsapp_product VALUES (556, 'K4 Sanitiser', '', '', '', 'Before sanitising ensure all surface are cleaned with 
suitable detergent. Dilute with cold potable water into a 
clean applicator bottle.
No-rinse application:
This product may be used as a no-rinse sanitiser on clean 
hard surfaces. Before use, all edible product and packaging 
material must be removed from the room or carefully 
protected. After use, a rinse with potable water is not 
required but food contact surfaces must be thoroughly 
drained / dried to minimise residues. For hard surfaces 
and equipment to ensure 320ppm use at the ratio of 1:250 
(4ml per litre). Apply by spray or clean cloth, Allow contact 
time of minimum 10 minutes. 
Rinse applications:
Use at the ratio of 1:200 (5ml per litre, 400ppm). Apply in 
a manner that avoids food contamination. Allow contact 
time of 10 minutes minimum then rinse with clean, 
potable water.
Foot bath:
Dilute at the ratio of 1:100 (10ml per litre, 800ppm).
It is recommended to do test strip verification of diluted 
solutions to ensure desired concentration.', 'FK-UCK4S02L', 'Kemsol', '', '', 72, 'No rinse surface sanitiser for food processing and food service sectors. Designed to be either diluted though
dilution control equipment or via the use of a multi-dose wall mounted unit.', false, '', '', '', 'Ultra Concentrate', 'Ultra Concentrate');
INSERT INTO public.chemsapp_product VALUES (557, 'K5 Toilet Cleaner', '', '', '', 'Ensuring well mixed, dilute at a ratio of 1:9 (10% soln, 100mls per litre) with potable water for toilet bowl 
applications into an applicator bottle with press-cap, then swirl around bowl and under rim. Leave for 10-15 
minutes then flush. Scrub only if needed. 
For a ‘spray n wipe’ solution use at a ratio of 1:49 (2% soln, 20mls per litre) with potable water into a 
suitable applicator bottle with spray head, then use as required', 'FK-UCK5T02L', 'Kemsol', '', '', 72, 'Cleaner, sanitiser and deodoriser designed to be diluted either through automatic dilution equipment or via the use of a multi-dose wall mounted unit, or accurate plunger device.', false, '', '', '', 'Ultra Concentrate', 'Ultra Concentrate');
INSERT INTO public.chemsapp_product VALUES (558, 'K6 Deodoriser', '', '', '', 'Dilute 1:9 into spray bottle and spray into the air where deodorising/reodorising is required', 'FK-UCK6D02L', 'Kemsol', '', '', 72, 'Two-stage action deodoriser that neutralises odours at the source, and designed to either be diluted through automatic dilution equipment or via the use of a multi-dose wall mounted unit.', false, '', '', '', 'Ultra Concentrate', 'Ultra Concentrate');
INSERT INTO public.chemsapp_product VALUES (559, 'K7 Disinfectant', '', '', '', 'Dilute 1:250 with water into a spray bottle or 1:500 into a bucket, apply to surface then wipe with a clean 
cloth or a paper towel.', 'FK-UCK7N02L', 'Kemsol', '', '', 72, 'Concentrated hard surface disinfectant for benches, walls and floors, Designed to be diluted either through automatic dilution equipment or via the use of a multi-dose wall mounted unit.', false, '', '', '', 'Ultra Concentrate', 'Ultra Concentrate');
INSERT INTO public.chemsapp_product VALUES (560, 'K8 Neutral Antibacterial Cleaner', '', '', '', 'For floor and general hard surface cleaning use at a ratio of 1:200 (0.5% soln, 5ml per litre) with warm or 
cold potable water. 
For ‘spray n wipe’ applications use at a ratio of 1:25 (5% solution, 50ml per litre) with cold potable water, 
then apply to surfaces, and wipe with a clean cloth or paper towel. ', 'FK-UCK8N02L', 'Kemsol', '', '', 72, 'A neutral antibacterial cleaner for benches, walls and floors. Designed to be diluted either through automatic dilution equipment or via the use of a multi-dose wall mounted unit, or accurate plunger device.', false, '', '', '', 'Ultra Concentrate', 'Ultra Concentrate');
INSERT INTO public.chemsapp_product VALUES (561, 'K-Buff', '', '', '', 'Spray: Dust mop floor to remove dust and dirt. Clean floor with K-SLIK. Spray diluted 1:4 with water onto the 
floor. Do not over wet the floor. Buff the floor using an approved pad with a low speed swing machine.
Mop and Bucket: Dust mop floor to remove dust and dirt. Dilute at a ratio of 15ml/litre with cold water. Mop 
floor with solution and pick up soil and excess with a tightly wrung out cleaning mop. Do not rinse floor. 
Allow floor to completely dry. Burnish with a high speed electric machine.', 'FK-KBUFF05', 'Kemsol', '', '', 72, 'Enhances the appearance of worn water-based floor finishes. Produces a brilliant gloss whilst removing scuffs, scratches and dirt from surfaces.', false, '', '', '', 'Floor Maintainer and Restorer', 'Floor Maintainer and Restorer');
INSERT INTO public.chemsapp_product VALUES (562, 'K-Clean', '', '', '', 'For heavy & spot cleaning use at a ratio of 1:20 with potable water (5% solution, 50ml per litre), then 
spray and wipe or wet-mop as required. 
Maintaining floors mix at 1:40 with potable water (2.5% solution, 25ml per litre). 
For other general hard surfaces use at a ratio of 1:60 to 1:100 for maintaining or spray buffing/glossing 
polished surfaces.', ' FK-KCLEAN05', 'Kemsol', '', '', 72, 'Multi-purpose detergent that cleans, sanitises and helps to maintain surface lustre. Suitable for a wide variety of modern hard surfaces. Surface-safe surfactants and essential oils assist the maintenance of polished and non-polished floor surfaces and all bathroom and janitorial hard surfaces.

As part of the Kemsol Floor Care System it is excellent to clean and maintain K-GLOSS. It gives brilliant results on polished wood floors and its Wild Forest fragrance is very popular.', false, '', '', '', 'Clean, Sanitise and Spray Buff', 'Clean, Sanitise and Spray Buff');
INSERT INTO public.chemsapp_product VALUES (563, 'Kem-Build', '', '', '', 'Inject undiluted solution into laundry machine at a ratio of 4-10mls per kg dry weight laundry. Use in 
conjunction with KEM-TEX. Please consult your KEMSOL representative for specific wash programs.', 'FK-KEMBUI05', 'Kemsol', '', '', 72, 'heavy-duty alkaline builder for use in the “break” wash on heavily soiled laundry textiles as part of automatically dosed laundry systems.', false, '', '', '', 'Heavy-Duty Alkaline Builder', 'Heavy-Duty Alkaline Builder');
INSERT INTO public.chemsapp_product VALUES (564, 'Kem-Tex', '', '', '', 'Inject undiluted solution into laundry machine at a ratio of 4-12mls per kg dry weight laundry in conjunction 
with KEM-BUILD or SIL-TEX. Please consult your KEMSOL representative for specific wash programs.', 'FK-KEMTEX05', 'Kemsol', '', '', 72, 'Built laundry detergent designed to be used as part of automatically dispensed laundry systems. It contains a blend of surfactants suitable for soil removal on a wide range of textiles. It can be used with builders for textiles with a high degree of soiling or can be used by itself for light to medium soiling, delicates or wool washes.', false, '', '', '', 'Liquid Laundry Detergent', 'Liquid Laundry Detergent');
INSERT INTO public.chemsapp_product VALUES (565, 'K-Gloss', '', '', '', 'Step 1: Apply to a clean neutral prepared floor by stripping old polish. We recommend the use of 
KEMSOL K-STRIP.
Step 2: Using a clean finish mop or applicator, apply 3 or 4 coats. Allow 30 minutes drying time between 
coats. Increased gloss and durability can be achieved by additional coats.
Step 3: Maintain finish by frequent dust mopping and wet cleaning with diluted K-CLEAN or K-SILK 
NEUTRAL CLEANER.', 'FK-KGLOSS05', 'Kemsol', '', '', 72, 'Metal cross-linked floor polish and sealer with superior durable wet-look gloss. Flows evenly, levels quickly, drying to a lustrous finish. Subsequent coats apply smoothly without drag, pulling, streaking or clouding. Resists surface scuffs & heel marks allowing extended periods between maintenance. Suitable where slip resistance required. Ultra long-wearing finish with high speed burnishers.', false, '', '', '', 'High Gloss Polish', 'High Gloss Polish');
INSERT INTO public.chemsapp_product VALUES (566, 'Kl1 Detergent', '', '', '', 'For use with Kemsol KemLock system only. Firmly connect Blue Kemlock cap. Use at a ratio 
2-4mls per kg dry weight laundry. Please consult your KEMSOL representative for specific wash 
programs', 'FK-KL1D05', 'Kemsol', '', '', 72, 'Contains a blend of surfactants suitable for soil removal on a wide range of textiles. Use with Kemsol KL2 Builder for textiles with heavy soiling. May be used by itself as a one-shot for light to medium soiling, delicates or wool washes.', false, '', '', '', 'Liquid Laundry Detergent', 'Liquid Laundry Detergent');
INSERT INTO public.chemsapp_product VALUES (567, 'Kl3 Oxy-Active', '', '', '', 'For use with Kemsol KemLock system only. Firmly connect Yellow KemLock cap. Use at a ratio 
of 2mls per kg of dry weight laundry', 'FK-KL3O05', 'Kemsol', '', '', 72, 'Stabilised Peracetic Acid in Hydrogen Peroxide. Use in commercial, industrial and on-premise laundry systems as a colour-safe stain treatment, and sanitiser.', false, '', '', '', 'Oxygen Laundry Destainer', 'Oxygen Laundry Destainer');
INSERT INTO public.chemsapp_product VALUES (568, 'Kl5 White Bright', '', '', '', 'For use with Kemsol KemLock system only. Firmly connect Yellow Kemlock cap. Use at a ratio of 
2mls per kg of dry weight laundry for destaining and 0.5 ml per kilo for sanitising.', 'FK-KL5W05', 'Kemsol', '', '', 72, 'Removes stains, maintains whiteness and sanitises. Can bleach dyes from coloured fabrics so always check fabric is suitable for chlorine treatment.', false, '', '', '', 'Chlorine Laundry Destainer', 'Chlorine Laundry Destainer');
INSERT INTO public.chemsapp_product VALUES (569, 'Kl6 Auto Dishwash', '', '', '', 'For use with Kemsol KemLock system only. Firmly connect Red Kemlock cap. Used at 0.5-2mls per litre via an 
automatic dosing pump.', 'FK-KL1A05', 'Kemsol', '', '', 72, 'Commercial high-strength liquid detergent formulated for use in automatic commercial dish and glasswash
machines. Suitable for crockery, china, glass and utensils.', false, '', '', '', 'Automatic Dishwash Detergent', 'Automatic Dishwash Detergent');
INSERT INTO public.chemsapp_product VALUES (570, 'Kl7 Rinse', '', '', '', 'For use with Kemsol KemLock system only for commercial automatic warewashing machines. 
Connect Blue Kemlock cap firmly. Dose automatically at 1 ml per litre in potable rinse water.', 'FK-KL7R05', 'Kemsol', '', '', 72, 'Aid to improve the speed and quality of the finishing of automatic machine washed dishes, cutlery and glassware. Leaves cutlery, glasses and dishware dry and spotlessly streak-free. Septic tank safe, when used as directed.', false, '', '', '', 'Rinse Additive', 'Rinse Additive');
INSERT INTO public.chemsapp_product VALUES (571, 'K-Pro Strip', '', '', '', 'Dilute between 1:2 and 1:6 with water depending on the level of polish. 
Apply solution liberally using a mop and allow to soak for 10-15 minutes. To ensure slurry is kept wet, reapply 
as necessary. Longer soak periods will be required if using cold water, or on areas with heavy levels of polish. 
Scrub floor using a scrubbing machine and heavy duty pad. 
Clean up solution using a clean mop or wet & dry vacuum cleaner. 
Allow floor to dry completely before sealing and consult your Kemsol representative or authorised distributor 
if further information is required.', 'FK-KPS05', 'Kemsol', '', '', 72, 'Commercial strength, professional, non-ammoniated floor polish stripper designed for the removal of water based floor finishes and sealers.', false, '', '', '', 'Professional Strength Floor Polish Stripper', 'Professional Strength Floor Polish Stripper');
INSERT INTO public.chemsapp_product VALUES (572, 'K-Slik', '', '', '', 'For most general wet mopping applications use at a ratio of 1:50 (2% soln, 20mls per litre) with 
potable water. 
May be diluted stronger or weaker depending on the level of soiling and sensitivity of floor coating.', 'FK-SLIK05', 'Kemsol', '', '', 72, 'Highly dilutable neutral detergent suitable for cleaning hard surfaces especially those coated in protectant or floor polish.', false, '', '', '', 'Neutral Cleaner', 'Neutral Cleaner');
INSERT INTO public.chemsapp_product VALUES (573, 'K-Strip', '', '', '', 'Use at a ratio of 1:5-1:2 (20-50% soln, 200ml to 500ml per Lt) with potable water. 
Apply solution liberally to polished floor using a mop.
Allow solution to soak for 5-10 minutes. Reapply solution as required, to ensure slurry is kept wet.
Allow longer soak periods if cold water is used, or for areas with a heavy build up of polish. 
Scrub floor using a scrubbing machine and a heavy duty scrubbing pad. 
Thoroughly pick up solution using a clean mop or wet and dry vacuum cleaner. Ensure solution is completely 
removed. 
Use a clean damp mop and fresh water to remove any residue. 
Allow floor to dry completely. Test to ensure neutral pH before re-polishing.', 'FK-KSTRIP05', 'Kemsol', '', '', 72, 'Powerful floor stripping agent for removing water-based floor polish finishes.', false, '', '', '', 'Floor Polish Stripper', 'Floor Polish Stripper');
INSERT INTO public.chemsapp_product VALUES (574, 'K-Tech', '', '', '', 'Apply to a clean, stripped (preferably using K-Pro Strip) and neutralisied floor. 
Using a clean finish mop or applicator, apply 3 or 4 coats of K-TECH in even, medium coats. 
Before recoating allow each coat to dry (30 minutes).
Increased gloss and durability can be achieved by additional coats. 
Maintain finish by frequent dust mopping and wet cleaning with K-CLEAN or K-SLIK', 'FK-KTEC05', 'Kemsol', '', '', 72, 'High-traffic extra-heavy-duty cross-linked floor polish and sealer. Superior durability, with a high-gloss finish. Flows evenly and levels quickly to dry to a lustrous gloss. Subsequent coats apply smoothly without drag, pulling, streaking or clouding. Ultra-long-wearing finish when used in high speed burnishing programs as well as in conventional maintenance programs.', false, '', '', '', 'Heavy-Duty Floor Polish', 'Heavy-Duty Floor Polish');
INSERT INTO public.chemsapp_product VALUES (575, 'Leader Fresh', '', '', '', 'For normal light duty hard surface floor cleaning dilute with warm or cold potable water at a ratio of 1:100 
(1% solution, 10ml per litre). 
Medium duty cleaning at a ratio of 1:50 (2% solution, 20ml per litre), and for heavy-duty cleaning, dilute to 
1:20 (5% solution, 50ml per litre).
May be used undiluted as a toilet bowl cleaner.', 'FK-LEAFR05', 'Kemsol', '', '', 72, 'A functional, mild pH disinfectant cleaner suitable for cleaning and sanitising hard surfaces such as floors, walls, benches, bathroom and kitchen areas leaving a lingering fragrance. Septic tank safe, when used as directed.', false, '', '', '', 'Cleaner Disinfectant', 'Cleaner Disinfectant');
INSERT INTO public.chemsapp_product VALUES (576, 'Leader Lemon', '', '', '', 'For normal light duty hard surface floor cleaning dilute with warm or cold potable water at a ratio of 1:100 
(1% solution, 10ml per litre). 
Medium duty cleaning at a ratio of 1:50 (2% solution, 20ml per litre), and for heavy-duty cleaning, dilute to 
1:20 (5% solution, 50ml per litre).
May be used undiluted as a toilet bowl cleaner', 'FK-LEALE05', 'Kemsol', '', '', 72, 'A functional, mild pH disinfectant cleaner suitable for cleaning and sanitising hard surfaces such as floors, walls, benches, bathroom and kitchen areas leaving a lingering fragrance. Septic tank safe, when used as directed.', false, '', '', '', 'Cleaner Disinfectant', 'Cleaner Disinfectant');
INSERT INTO public.chemsapp_product VALUES (577, 'Leader Marine', '', '', '', 'For normal light duty hard surface floor cleaning dilute with warm or cold potable water at a ratio of 1:100 
(1% solution, 10ml per litre). 
Medium duty cleaning at a ratio of 1:50 (2% solution, 20ml per litre), and for heavy-duty cleaning, dilute to 
1:20 (5% solution, 50ml per litre).
May be used undiluted as a toilet bowl cleaner', 'FK-LEAMA05', 'Kemsol', '', '', 72, 'A functional, mild pH disinfectant cleaner suitable for cleaning and sanitising hard surfaces such as floors, walls, benches, bathroom and kitchen areas leaving a lingering fragrance. Septic tank safe, when used as directed.', false, '', '', '', 'Cleaner Disinfectant', 'Cleaner Disinfectant');
INSERT INTO public.chemsapp_product VALUES (578, 'Leader Spice', '', '', '', 'For normal light duty hard surface floor cleaning dilute with warm or cold potable water at a ratio of 1:100 
(1% solution, 10ml per litre). 
Medium duty cleaning at a ratio of 1:50 (2% solution, 20ml per litre), and for heavy-duty cleaning, dilute to 
1:20 (5% solution, 50ml per litre).
May be used undiluted as a toilet bowl cleaner', 'FK-LEAALL05', 'Kemsol', '', '', 72, 'A functional, mild pH disinfectant cleaner suitable for cleaning and sanitising hard surfaces such as floors, walls, benches, bathroom and kitchen areas leaving a lingering fragrance. Septic tank safe, when used as directed.', false, '', '', '', 'Cleaner Disinfectant', 'Cleaner Disinfectant');
INSERT INTO public.chemsapp_product VALUES (579, 'Lemon Dishwash', '', '', '', 'Manual sink washing application, use at a ratio of 1:500 (0.25% soln, 25mls per 10ltrs) in warm potable water 
(more or less depending on soiling levels).
Hard surface applications, use at a ratio of 5 to 30mls per 10 litres of water, depending on the level of soiling.
Window cleaning use 5mls per 10 litres of water. Spray onto windows and wipe with clean paper towel.
Vehicle washing use 20mls per 10 litres of water. Sponge onto vehicle and rinse with water.', 'FK-LEMD05', 'Kemsol', '', '', 72, 'Med-high foaming general purpose biodegradable hand dishwashing detergent, suitable for a wide range of washing applications. Ideal for manual dishwashing but can also be used for hard-surface cleaning and the handwashing of vehicles and windows. Septic tank safe, when used as directed.', false, '', '', '', 'General Purpose', 'General Purpose');
INSERT INTO public.chemsapp_product VALUES (580, 'Limesoft', '', '', '', 'Work directly onto hands and rinse off. Repeat if required', 'FK-LIME04', 'Kemsol', '', '', 72, 'A pleasantly lime-fragranced, citrus-based heavy-duty hand cleaner with glass-dust abrasive designed to remove grease, ink and heavy soiling from hands. Contains a natural moisturiser, designed to keep skin in good condition. Deodorises hands and is biodegradable.', false, '', '', '', 'Hand Cleaner', 'Hand Cleaner');
INSERT INTO public.chemsapp_product VALUES (581, 'Liminate', '', '', '', 'Spray directly and sparingly into the air using a pump action spray bottle or fogging machine. Will act 
instantly to react with noxious odours leaving the atmosphere free of odour and with a floral fragrance.', 'FK-LIM05', 'Kemsol', '', '', 72, 'Two-stage high-strength deodorant & reodorant which neutralises existing odours, and leaves a lasting floral fragrance. Effective against a wide range of odours from a variety of sources including tobacco, alcohol, decaying vegetable matter, mould, mildew, faeces, food waste, fermentations and biological waste.', false, '', '', '', 'Commercial Strength Deodorising Agent', 'Commercial Strength Deodorising Agent');
INSERT INTO public.chemsapp_product VALUES (582, 'Lustre', '', '', '', 'Shake container well before use. Apply sparingly using a spray nozzle, or preferably poured directly onto a 
clean, dry rag, then applied to interior vehicle surfaces such as dashboards and plastic synthetic surfaces. 
Polish with a soft cloth. Repeat as required. 
Always test on an inconspicuous spot prior to use to ensure compatibility.
For leather seats spray onto cloth and then wipe using the product sparingly.', 'FK-LUSTRE05', 'Kemsol', '', '', 72, 'Safe and economical rejuvenator that leaves a wide range of surfaces looking like new with a pleasant fragrance. Unique, non-greasy formulation protects against discolouration. Contains antistatic repellents helping reduce dust build-up. No alcohol or harsh solvents. Ideal on polished wood, plastics, vehicle dashboards, vinyl and rubber.', false, '', '', '', 'Multi-Surface Reviver & Finisher', 'Multi-Surface Reviver & Finisher');
INSERT INTO public.chemsapp_product VALUES (583, 'Microban', '', '', '', 'Dispense 2-5mls of MICROBAN directly onto hands 
neat and rub hands together to give an even 
coverage. In food processing plants, the sanitiser 
must only be supplied from a fixed, metered 
dispenser located a sufficient distance from the 
processing line to prevent product contamination. 
Hands must be clean before the sanitiser is applied 
(this includes washing the hands where necessary).', 'FK-MICRO500', 'Kemsol', '', '', 72, 'Powerful ethanol-based hand sanitiser that evaporates quickly, leaving your hands feeling clean and fresh. When used on washed, dried hands or between washes, it helps to maintain hygienic conditions.', false, '', '', '', 'Sanitising Hand Gel', 'Sanitising Hand Gel');
INSERT INTO public.chemsapp_product VALUES (584, 'Moss-Kill', '', '', '', 'For initial application, use at a ratio of 1:4 (200mls per litre, 20% soln) with cold potable water and a ratio of 
1:20 (50mls per litre, 5% soln) for subsequent applications. Spray onto surfaces, and leave.
For best results allow a dry contact time of at least 3 hours. Most surfaces do not require rinsing although 
some aged painted surfaces may require a rinse to avoid streaking.
Best applied first thing in the morning or last thing at night onto a cool surface to minimise evaporation with 
no rain expected for 12 hours.', 'FK-MOSKI05', 'Kemsol', '', '', 72, 'Easy to use and effective agent that controls moss, mould, mildew, lichen and algae growing on most exterior hard surfaces. Popular ‘wet and walk’ type product', false, '', '', '', 'Algae Mould Moss & Lichen Control', 'Algae Mould Moss & Lichen Control');
INSERT INTO public.chemsapp_product VALUES (585, 'Neptune', '', '', '', 'Flush areas with water then, using undiluted, squirt a 
liberal amount around the top and under the rim of the 
bowl. Allow to slowly run down the porcelain and then 
scrub with a brush whilst flushing.', 'FK-NEP05', 'Kemsol', '', '', 72, 'A high-viscosity ready-to-use toilet bowl and washroom cleaner. Cleans and deodorises. The thick flowing formula means longer  contact time and the pleasant fragrance, leaves toilets clean and fresh. Septic tank safe, when used as directed.', false, '', '', '', 'Toilet Cleaner', 'Toilet Cleaner');
INSERT INTO public.chemsapp_product VALUES (586, 'Odatrol', '', '', '', 'Sprinkle granules as required onto waste areas. Regular sprinkling as bins etc fill, will provide the best results', 'FK-ODA10', 'Kemsol', '', '', 72, 'Designed to remove offensive odours typical in waste and skip-bin environments. An effective agent assists to leave a lasting and pleasant fragrance. Two-stage action effectively draws in offensive odours, releasing a pleasant fragrance to mask remaining odour.', false, '', '', '', 'Deodorising & Reodorising Granules', 'Deodorising & Reodorising Granules');
INSERT INTO public.chemsapp_product VALUES (587, 'Oil Clean Wb', '', '', '', 'For spot cleaning use undiluted on oil and grease spots. Scrub affected areas as required and rinse with water. 
For full floor coverage use at a ratio of 1:20 - 1:10 (5-10% soln, 50-100ml per litre) with potable cold water. 
Sweep or brush area prior to hosing off. 
If using a water blaster use a 5% solution applied at low pressure and remove by blasting off at high pressure. 
Plant and Machinery use at a ratio best determined for the job at a 10-20% solution and rinse off. 
Parts cleaning by hand use at a 25-50% solution. Rinse with water.', 'FK-OILCL05', 'Kemsol', '', '', 72, 'Formulated as an environmentally safe alternative to solvent based and non-biodegradable water based cleaning systems. Effectively on oils, grease and other hard surface soiling. Solids are suspended until flushed into holding tanks, separator pits or settling ponds where separation occurs to form distinct water and oil layers allowing easy removal of unwanted contamination from discharge water.', false, '', '', '', 'Water Based Cleaner & Degreaser', 'Water Based Cleaner & Degreaser');
INSERT INTO public.chemsapp_product VALUES (588, 'Oxalic Wash', '', '', '', 'Add at a ratio of 2-10gms per kg dry weight laundry to break wash, WITHOUT THE ADDITION OF USUAL 
BREAK-CYCLE DETERGENTS. Continue wash cycle as normal using usual cycle-detergents. 
As a pre-soak add at a ratio of 10gms per kg dry weight laundry for pre-soaking. For specific staining advice 
please contact your Kemsol representative', 'FK-OXW05', 'Kemsol', '', '', 72, 'Designed as an effective shock-dose deep cleaning agent for commercial and industrial laundry applications. It assists in the removal of detergent residues and the removal of deep stains.', false, '', '', '', 'Laundry Wash Aid', 'Laundry Wash Aid');
INSERT INTO public.chemsapp_product VALUES (589, 'Oxy-Safe', '', '', '', 'As a presoak use at a ratio of 1:300 (30grams/1 scoop per 10 litres) with warm to hot water. More for 
heavily soiled or stained garments. Allow to soak for at least 30mins before washing. Nappies can be 
soaked in a similar solution then rinsed in water and dried in direct sunlight. With care, performance can 
be significantly enhanced with the use of hot water (80deg C) providing high temperatures are garment 
compatible', 'FK-OXY05', 'Kemsol', '', '', 72, 'Oxygen bleach revitaliser that cleans and sanitises laundry linen, clothes and fabrics. Hygienically removes stains and odours and enhances brightness. Not for use on woollens, silks, or metals. Safe on dye fast coloured material. If unsure of suitability', false, '', '', '', 'Oxygenated Safety Bleach', 'Oxygenated Safety Bleach');
INSERT INTO public.chemsapp_product VALUES (590, 'Oxy-Soaker', '', '', '', 'As a pre-soak use at a ratio of 1:220 (0.4% soln, 40 gms per 10 litres) of hot potable water. Allow items to 
soak for minimum of 10-15 minutes, or longer for more stubborn staining', 'FK-OXYSOAK05', 'Kemsol', '', '', 72, 'Powder pre-soak ‘chlorine free’ formulation for the removal of tea, coffee and juice stains from crockery, plastics and cutlery, prior to machine dishwashing.', false, '', '', '', 'Oxygenated Pre-Soaker', 'Oxygenated Pre-Soaker');
INSERT INTO public.chemsapp_product VALUES (591, 'Paris', '', '', '', 'Ready to use, atomised using a hand spray system. Atomise into the air in rooms containing odours or 
directly at the source of an odour if possible', 'FK-PARIS05', 'Kemsol', '', '', 72, 'A powerful odour neutraliser which attacks odour molecules and neutralises them immediately. Contains a pleasant fragrance which leaves a lingering fresh scent. It is ideal for controlling a wide range of malodours including decaying garbage, cooking odours, smoke, animals, body odours and is ideal for use in hotels and motels.', false, '', '', '', 'Commercial Strength Deodorising Agent', 'Commercial Strength Deodorising Agent');
INSERT INTO public.chemsapp_product VALUES (592, 'Phase-Out', '', '', '', 'For all general hard surfaces dilute at 1:50 (2% soln, 20mls per ltr) with potable warm or cold water. 
May be used stronger or weaker, depending on the severity of the odour situation, or level of cleaning 
required. Surfaces may be rinsed with fresh water, or allowed to air-dry', 'FK-PHA05', 'Kemsol', '', '', 72, 'Highly efficient twin-chain quaternary cationic germicide for a true odour neutralising agent. Lingering odours from toilet/shower areas, camp grounds, ablution blocks and exterior food waste environments are neutralised, disinfected and refreshed in one step. Useful as a cleaning agent, particularly for solvent sensitive surfaces such as tar-seal and asphalt.', false, '', '', '', 'Deodoriser, Re-odoriser, Sanitiser & Cleaner', 'Deodoriser, Re-odoriser, Sanitiser & Cleaner');
INSERT INTO public.chemsapp_product VALUES (593, 'Phoric 675', '', '', '', 'Dilution rates for CIP applications vary depending on soiling levels. 
For most general daily operations use at a ratio of 1:1000 to 1:100 (0.1-1% soln, 1-10ml per litre) with 
potable water. Circulate for 15-20 minutes. 
Ensure all surfaces are thoroughly rinsed. Stronger dilution rates may be used under representative or plant 
SOP instruction.', 'FK-PHORIC05', 'Kemsol', '', '', 72, 'heavy-duty phosphoric based low-foaming acid/detergent/ sanitiser for use in CIP applications for the removal of dissolved solids and alkaline residues. Also removes surface rusting from ferrous metals and protects against subsequent re-rusting.', false, '', '', '', 'Heavy-Duty Acid Cleaner & Sanitiser', 'Heavy-Duty Acid Cleaner & Sanitiser');
INSERT INTO public.chemsapp_product VALUES (594, 'Phosclean', '', '', '', 'Water hardness build up and milk stone removal requires a 2.5% solution in hot water (65°C) to be circulated for 
15-30 minutes then rinsed. Cooler water may be used with higher concentrations or longer contact times. Rinse 
with cold water. For rust removal use neat or dilute to 20% solution. Apply to surface and leave for 5-30 minutes 
before rinsing with cold water', 'FK-PHOSCL05', 'Kemsol', '', '', 72, 'Removes mineral deposits, milk stone build up and sanitises in one operation. It also removes surface rusting from ferrous metals and protects against subsequent re-rusting.', false, '', '', '', 'Acid Cleaner & Sanitiser', 'Acid Cleaner & Sanitiser');
INSERT INTO public.chemsapp_product VALUES (595, 'Pronto', '', '', '', 'Mildew and Mould use at a ratio of 1:4 (20% solution, 200ml per litre) with potable water. Spray onto surfaces and wipe with a damp cloth. Rinse 
surfaces thoroughly with water. 
Toilet Bowls pour directly undiluted around the bowl and allow 5-10 minutes dwell time before agitating and flushing. 
Exterior washing (Heavy duty) use at a ratio of 1:20 (5% solution, 50ml per litre), 
Exterior (Light duty) use at a ratio of 1:50 (2% solution, 20ml per litre). 
For Sanitising use at a ratio of 1:40 (2.5% solution, 25ml per litre) then rinse to finish. 
This product has bleaching properties and can permanently bleach colour from textiles and older painted surfaces. Always test on an inconspicuous 
small area before proceeding. 
When diluted has a high foaming action that allows it to adhere to vertical surfaces to give longer dwell times for bactericidal activity.
NZ DHB and MOH Guidelines for use of Sodium Hypochlorite when mixed in solution with potable cold water:
Critical Hard Surface Hygiene; Floors, Taps, Toilets, Baths, Sumps, Sluices; 2% solution (1:49) provides 1,000PPM FAC (MOH & DHB) Faecal and 
Heavily Soiled Surface Hygiene: 10% solution (1:9) provides 5,000 PPM FAC (MOH) Blood and Body Spills: 20% solution (1:19) provides 10,000 PPM 
FAC (DHB)', 'FK-PRONTO05', 'Kemsol', '', '', 72, 'Powerful thickened Sodium Hypochlorite based formula giving wide spectrum bactericidal activity against Typhimurium, Staphylococcus auras, Escherichia coli, Streptococcus ssp, Listeria monocytogenes, Bacillus subtilis, Candida albicans, Asperillus and other wild yeast, fungi, moulds and mildews. Effective against HIV and Hepatitis A on hard surfaces.', false, '', '', '', 'Heavy-Duty Chlorinated Cleaner Sanitiser', 'Heavy-Duty Chlorinated Cleaner Sanitiser');
INSERT INTO public.chemsapp_product VALUES (596, 'Protect', '', '', '', 'Apply undiluted directly to rubber surfaces with a cloth or spray bottle. Allow to soak in before buffing 
with a clean cloth. Works best when regular use allows penetration of the tyre wall.', 'FK-PROTEC05', 'Kemsol', '', '', 72, 'Silicone-based treatment for reviving and restoring rubber tyres to near original condition. Provides a long lasting shine without leaving a heavily greasy film.', false, '', '', '', 'Rubber Tyre Restorer', 'Rubber Tyre Restorer');
INSERT INTO public.chemsapp_product VALUES (597, 'Proton Cip', '', '', '', 'Dilute PROTON CIP between 0.5% (0.5:100) to 2% depending on soiling type, at between 60-70 degrees C, and circulate. 
Always finish CIP cleaning with a thorough flush, and pH test discharge water to ensure pH is the same as supply water 
source. For hard surface cleaning dilute 1% to 5%.', 'FK-PROCIP20', 'Kemsol', '', '', 72, 'Premium non-chlorinated, low-foaming liquid alkaline CIP detergent used for cleaning heavy soiling of processing vessels and equipment in Processed Food and Beverage plants through CIP applications. Contains advanced surfactants and anti scaling technology to help safe guard stainless steel vessels from mineral scale build up.', false, '', '', '', 'Alkaline Detergent For CIP', 'Alkaline Detergent For CIP');
INSERT INTO public.chemsapp_product VALUES (598, 'Quantum', '', '', '', 'Inject undiluted directly into wash water at 1-2mls per litre via an automatic peristalitic pump. Not 
recommended for manual dosing, unless in contingency commercial situations. Use in conjunction with 
KEMSOL RINSE AID for optimum performance. ', 'FK-QUACO05', 'Kemsol', '', '', 72, 'Commercial high-strength liquid detergent formulated for use in automatic commercial dish and glasswash machines. Suitable for use with all common ware materials such as crockery, china, glass, stainless steel and plastics and kitchen utensils. Not recommended for aluminium or other soft metal-constructed kitchen items. Septic tank safe, when used as directed.nSuitable for dishwashing or glass washing applications with or without the use of a rinse aid. This formulation has approvals from both New Zealand Breweries Ltd and Lion Breweries Ltd.', false, '', '', '', 'Automatic Dish and Glass Washing Liquid', 'Automatic Dish and Glass Washing Liquid');
INSERT INTO public.chemsapp_product VALUES (599, 'Quat2000', '', '', '', 'For general spray and wipe applications use 5ml per litre (5% soln, 500ppm). For critical /highly 
contaminated areas use 10ml per litre (10% soln, 1000ppm). Spray generously and allow contact time 
of 10min minimum. Wipe with clean cloth, rinse with clean, potable water, wipe dry using clean cloth or 
paper towel.
This may be used as a no-rinse sanitiser on clean hard surfaces in licensed premises which are restricted 
only to the processing of fish. Before use, all edible product and packaging material must be removed 
from the room or carefully protected. After use, a rinse with potable water is not required but food 
contact surfaces must be thoroughly drained to minimise residues. When used as a sanitiser in other 
licensed premises, surfaces must be thoroughly rinsed with potable water before production starts. This 
product must always be used at the dilutions recommended by the manufacturer', 'FK-QUAT205', 'Kemsol', '', '', 72, 'Unscented sanitiser with neutral pH that is safe to use on food processing equipment, fittings, floors, walls and benches. Kills a wide range of pathogens and its antimicrobial action reduces unpleasant odours.', false, '', '', '', 'Food Surface Sanitiser', 'Food Surface Sanitiser');
INSERT INTO public.chemsapp_product VALUES (600, 'Quatrol', '', '', '', 'General hard surface disinfecting use at a ratio of 1:100 (10ml per litre, 1% soln) with potable water. 
Spray or wet mop solution over surfaces, allowing 10-15 minutes minimum contact time.', 'FK-QUAT05', 'Kemsol', '', '', 72, 'Broad spectrum quaternary liquid cationic germicide developed for the use in all areas that require disinfecting. As a super concentrate, follow directions to ensure costs in use can be correctly maintained, and over use of the disinfecting agent does not occur.', false, '', '', '', 'Super Concentrate Disinfectant', 'Super Concentrate Disinfectant');
INSERT INTO public.chemsapp_product VALUES (601, 'Red Dog', '', '', '', 'Wet surface thoroughly with cold water. Apply to a sponge, non-scratch scrubbing pad or glass compatible 
doodle bug with enough water to make a damp paste. Scrub surface ensuring an even coverage and 
pressure is applied. Always keep damp by adding more water if required. Leave for 3-5 minutes to work 
thoroughly. Rinse entire surface with cold water and dry. 
In extreme cases additional applications may be required', 'FK-REDDOG300', 'Kemsol', '', '', 72, 'Ready-to-use descaling and water spot remover. Particularly useful in shower and bathroom applications where dissolved solids or “water marks” have stained surfaces.', false, '', '', '', 'Hard Water Stain Remover', 'Hard Water Stain Remover');
INSERT INTO public.chemsapp_product VALUES (602, 'Red Jet', '', '', '', 'Should be installed in a powder bowl unit by an authorised Kemsol Representative. May also be used as a 
heavy duty CIP cleaner or for manual cleaning applications. ', 'FK-SUPBO4.5', 'Kemsol', '', '', 72, 'Highly concentrated alkaline powder detergent designed to be used in wall mounted automatic powder dispensers. Provides excellent cleaning results at a competitive price compared to liquid systems. Removes all soiling and rinses freely.', false, '', '', '', 'Powder Dishwash', 'Powder Dishwash');
INSERT INTO public.chemsapp_product VALUES (603, 'Red Rhino', '', '', '', 'For usual medium duty cleaning use at a ratio of 1:50 (2% solution, 20mls per litre) with potable water. 
For spray and wipe applications use at a ratio of 1:25 (4% solution, 40ml per litre). 
For heavy duty cleaning use at a ratio of 1:9 (10% solution, 100ml per litre). 
High Pressure cleaning, dilute 1:100 - 1:200. Rinse with water after use', 'FK-REDIN05', 'Kemsol', '', '', 72, 'Multi-purpose cleaner degreaser that can be used in a range of commercial and industrial applications. Suitable for cleaning a wide range of hard surfaces including floors, benches, tiles, bathrooms, showers, basins etc. Suitable for removing oil, grease and carbon soiling and dust from concrete floors and for use through high-pressure water blasters for washing exterior surfaces.', false, '', '', '', 'Heavy-Duty Cleaner Degreaser', 'Heavy-Duty Cleaner Degreaser');
INSERT INTO public.chemsapp_product VALUES (604, 'Reflexion', '', '', '', 'For all usual glass windows and mirror surfaces use at ratio of 
1:1 (500ml/Litre (2 cups), 50% soln) with cold potable water. 
Spray on and wipe with a dry, clean, lint free cloth. Wipe to 
dry with a clean paper towel for best results', 'FK-REFL05', 'Kemsol', '', '', 72, 'A ready-to-use, quick-drying eco-focused window and glass cleaner concentrate. Septic tank safe, when used as directed.', false, '', '', '', 'Glass, Mirror & Windows', 'Glass, Mirror & Windows');
INSERT INTO public.chemsapp_product VALUES (605, 'Rejuvenate', '', '', '', 'As a pre-soak use at a ratio of 1:150 (60gm/2 scoops per 10 litres) with warm to hot water. More for heavily 
soiled or stained garments. Allow to soak for at least 30mins before washing. 
Nappies can be soaked in a similar solution then rinsed in water and dried in direct sunlight. 
With care, performance can be significantly enhanced with the use of hot water (80deg C) providing high 
temperatures are garment compatible.', 'FK-REJUVPO05', 'Kemsol', '', '', 72, 'Oxygen-releasing laundry agent for cleaning and sanitises clothes, nappies and other fabrics. Hygienically removes stains and odours and gives clothes extra brightness. Not suitable for use on woollens or silks, or garments containing metal. Safe on dye fast coloured material — always check washing instructions on garment/s before proceeding.', false, '', '', '', 'Antibacterial Nappy and Fabric Cleanser', 'Antibacterial Nappy and Fabric Cleanser');
INSERT INTO public.chemsapp_product VALUES (606, 'Renegade Pro', '', '', '', 'Apply the Renegade pro evenly over the surface by using the applicator bottle or extended spray head. 
For best results, heat up the surface to 55-70 degrees, and leave for a period of 5 minutes, lightly agitate, 
followed by rinsing the surface with fresh, clean water.
CAUTION: Do not apply onto surfaces above 70ºC. Do not use on aluminium. Do not mix with other 
chemicals. Do not use this product through a combi oven/self cleaning oven.', 'FK-RENP05', 'Kemsol', '', '', 72, 'High performance cleaner for quick and effective removal of grease and heavy carbon soiling throughout the kitchen and other applications. Non-gel formula for easy use, making it ideal for hotplates, grills and ovens. Renegade Pro can be used in various applications for cleaning and daily maintenance of drains.', false, '', '', '', 'Heavy-Duty Oven & Grill Cleaner', 'Heavy-Duty Oven & Grill Cleaner');
INSERT INTO public.chemsapp_product VALUES (607, 'Rinse Aid', '', '', '', 'For commercial automatic glasswash machines inject via an automatic pump at a ratio of 1:1000 (0.1% 
solution, 1ml per litre) with potable rinse water. 
For industrial warewash units use up to a ratio of 1:400 (0.25% solution, 2.5mls per litre) of potable 
rinse water.
For domestic applications, fill the rinse-aid dispenser', 'FK-RINAID05', 'Kemsol', '', '', 72, 'Drying agent to assist the speed and quality of the finishing of automatically machine washed dishes, cutlery and glassware. Leaves washed surfaces dry and spotlessly streak-free. Septic tank safe, when used as directed.', false, '', '', '', 'Spot-Free Rinse Additive', 'Spot-Free Rinse Additive');
INSERT INTO public.chemsapp_product VALUES (608, 'Rock-It', '', '', '', 'Dispense 4ml from pump and work over hands completely. Rinse off with potable water. Repeat if required.', 'FK-ROCK24', 'Kemsol', '', '', 72, 'A natural pumice-based, heavy-duty hand cleaner for removing automotive grease, ink, carbon and heavy soiling. Contains a naturally occurring citrus solvent to cut through the toughest soiling. Moisturises and conditions hands with added lanolin.', false, '', '', '', 'Heavy-Duty Pumice-Based Hand Cleaner', 'Heavy-Duty Pumice-Based Hand Cleaner');
INSERT INTO public.chemsapp_product VALUES (609, 'Room Fresh', '', '', '', 'Apply undiluted with atomising spray bottle directly into 
rooms containing odours or directly at the odour source, 
when possible. Room deodorising is best achieved using a 
sweeping action while spraying up into the ceiling corners.', 'FK-ROOMFRFL05', 'Kemsol', '', '', 72, 'Two-stage odour control that neutralises and leaves a lingering floral fragrance. Immediately attacks malodour molecules including decaying garbage, cooking odours, smoke, animals, body odours and bathroom/toilet areas. Septic tank safe, when used as directed.', false, '', '', '', 'Floral Deodoriser', 'Floral Deodoriser');
INSERT INTO public.chemsapp_product VALUES (610, 'Sani Brite', '', '', '', 'Glass & Cutlery: Soak in 30gm (1 scoop) to 5L cold/warm water for minimum 5 mins. Rinse prior to use.
Wipedown Cloths: Soak in 30-60gm (1-2 scoops) to 5L cold/warm water for 15-20 mins. Rinse and air dry 
before use.
CIP Equipment Sanitising: 3gm per 1L or 1 teaspoon per 2L potable water. Circulate for minimum 10 mins and 
fully flush-rinse system before re-use. (100PPM FAC)
Hard Surface Spray Sanitising: 2gm (1/2 teaspoon) to 1L of potable water. Spray over surfaces and wipe with a 
clean cloth or paper towel. (300ppm FAC)
A full included scoop provides approx 30gm.', 'FK-SANBR12', 'Kemsol', '', '', 72, 'Biodegradable hypochlorite based antibacterial powder for soaking or spray and wipe applications. Stable, freely soluble formula that contains a detergent for greater soiling penetration. Satisfies a multitude of specialist Food Service applications; useful as a diluted cleaner, descaler and sanitiser. Safe for a variety of uses including glass and cutlery soaking, hard surface sanitising, bar cloth soaking and periodic treatment for ice machines and soft serve machinery and equipment. nnNot recommended for sanitising aluminium surfaces as dulling may occur.', false, '', '', '', 'Cutlery Soak and Sanitiser', 'Cutlery Soak and Sanitiser');
INSERT INTO public.chemsapp_product VALUES (611, 'Sani-Care', '', '', '', 'For most descaling and heavy cleaning applications use undiluted through a spray or suitable applicator 
bottle. Spray on surfaces, leave for 5 minutes, then agitate with a stiff brush, if required, before rinsing with 
potable water', 'FK-SANCA05', 'Kemsol', '', '', 72, 'Light acid-type cleaner sanitiser, ideal for ceramic tiles and stainless steel bathroom areas. Removes salt encrustations in toilets and urinals without causing bloom. Disinfects as it cleans.', false, '', '', '', 'Ceramic and Stainless Steel Acid Cleaner', 'Ceramic and Stainless Steel Acid Cleaner');
INSERT INTO public.chemsapp_product VALUES (612, 'Sani-Foam', '', '', '', 'For automatic dilution devices, depending on soiling levels 
and required speed of clean, foam at a ratio of 1:20 (5% 
solution, 50ml per litre) to 1:100 (1% solution, 10ml per 
litre) with potable cold water. 
Adjust air pressure (if applicable) to achieve optimum 
foam density. Foam surfaces and equipment, and leave for 
5-10 minutes before brushing and/or thoroughly rinsing. 
For general medium-duty cleaning use at a ratio of 1:50 
(2% solution, 20mls per litre) with potable water.', 'FK-SANIF05', 'Kemsol', '', '', 72, 'Concentrated combined cleaner and chlorine-based sanitising agent for use manually or with an automatic dilution and foaming device to cleanse and sanitise food process hard surfaces. Ideal when large process areas require regular, efficient and hygienic cleaning.', false, '', '', '', 'Foaming Cleaner and Sanitiser', 'Foaming Cleaner and Sanitiser');
INSERT INTO public.chemsapp_product VALUES (613, 'Score', '', '', '', 'Fill machine dispenser or hopper and run machine cycle. May be used as a pre-soak for crockery and 
glassware by using 20g per litre of hot water. If streaking is noticed, reduce the amount being used.
1 supplied scoop = 30g
Not recommended for cleaning items made from aluminium or silver', 'FK-SCODI02', 'Kemsol', '', '', 72, 'Powerful surface-safe, powdered detergent for use in automatic domestic dishwashers. In one operation all
residues are removed (including protein) from cutlery, glassware and crockery leaving items sparkling clean.
Prevents haze, water spotting and streaking. Septic tank safe, when used as directed.', false, '', '', '', 'Automatic Dishwash Powder', 'Automatic Dishwash Powder');
INSERT INTO public.chemsapp_product VALUES (614, 'Shampoo', '', '', '', 'Apply 5ml (1 tsp) by hand directly from the dispenser 
or plunger pack to wet hair. Lather well and rinse off. 
Repeat if required', ' FK-SHAMPOO05', 'Kemsol', '', '', 72, 'A gentle, everyday shampoo that is soft on hair and gentle on skin. The smooth creamy lather cleans hair without drying the scalp and leaves a soft floral fragrance. Septic tank safe, when used as directed.', false, '', '', '', 'Hair and Body Wash', 'Hair and Body Wash');
INSERT INTO public.chemsapp_product VALUES (615, 'Shower Power', '', '', '', 'Use undiluted and spray directly onto surfaces, preferably with a foaming nozzle. Leave for a few minutes to 
interact with the soiling, then wipe off and rinse with potable water. A brush or non-scratching white pad or 
nylon netting may be used on heavily soiled surfaces.', 'FK-SHPOW05', 'Kemsol', '', '', 72, 'Bathroom and shower concentrate formulated to clean soap and body fat buildup from a wide range of modern and traditional surfaces such as glass, porcelain, formica, ceramic, plastics, stainless steel and tiles. Septic tank safe, when used as directed.', false, '', '', '', 'Bathroom Cleaner', 'Bathroom Cleaner');
INSERT INTO public.chemsapp_product VALUES (616, 'Sil-Tex', '', '', '', 'Inject undiluted product into laundry washer, either as a break at 10ml per 1kg dry laundry or as a builder at 
5-10ml per 1kg dry laundry along with 8-12ml per 1kg of KEM-TEX', 'FK-SILTEX20', 'Kemsol', '', '', 72, 'Heavy-duty alkaline builder which contains soil suspension agents for removing heavy soiling. Dispensed through Kemsol’s automatic laundry system and designed for use with KEM-TEX laundry detergent.', false, '', '', '', 'Silicated Laundry Builder Liquid', 'Silicated Laundry Builder Liquid');
INSERT INTO public.chemsapp_product VALUES (617, 'Soft Suds', '', '', '', 'For all general manual sinkwash applications use at a ratio of 1:300 (0.3% solution, 10mls to 3 ltrs) with 
potable warm to hot water. Wash dishes and stand to air-dry.', 'FK-SOFT05', 'Kemsol', '', '', 72, 'Medium-foam high-strength detergent suitable for manual hand dishwashing. Soft on hands but powerful on dishes. Controlled suds level allows easy rinsing. May also be used as a general light-medium cleaner for floors and other manual cleaning applications. Septic tank safe when used as directed.', false, '', '', '', 'Manual Dishwashing Detergent', 'Manual Dishwashing Detergent');
INSERT INTO public.chemsapp_product VALUES (618, 'Solve', '', '', '', 'Usage will vary depending on soiling levels and types. Light soiling: 60-150mls per 30kg wash. Heavy soiling: 200mls per 30kg wash. Polyester/cotton uniforms, work coats etc: 60-150mls Table linen, mechanics overalls, dust mats and mops: 60-150mls Add to the wash with or without other detergents and alkali.', 'FK-SOLV05', 'Kemsol', '', '', 72, 'Concentrated emulsifying solvent for use on a wide range of fabrics including cottons, polyester/cotton, synthetics, woollens etc. It is effective in removing fats, oils and waxes.', false, '', '', '', 'Laundry Solvent & Emulsifier', 'Laundry Solvent & Emulsifier');
INSERT INTO public.chemsapp_product VALUES (619, 'Spa-Bac', '', '', '', 'Ensure bath surfaces are clean and fill to usual operating level. Add 40-60mls to a standard 500ltr spa bath 
and operate circulating system for 5-10 minutes. Drain and spray and wipe surfaces mixed at 1:4 (20% soln, 
200mls per litre) with potable water.', 'FK-SPA05', 'Kemsol', '', '', 72, 'Highly efficient broad spectrum quaternary liquid cationic germicide. It has been specifically developed for the disinfecting of spa baths. Simply clean between guest use to ensure a clean and sanitary environment of all visible and non-visible spa bath surfaces. Specifically designed to eliminate buildup in pipe work, filters and plumbing which can become quickly contaminated.', false, '', '', '', 'Sanitiser & Disinfectant', 'Sanitiser & Disinfectant');
INSERT INTO public.chemsapp_product VALUES (620, 'Spray ''N'' Wash', '', '', '', 'Spray directly on dirty spots and marks prior to washing. Wash laundry in normal wash', 'FK-SPWSH05', 'Kemsol', '', '', 72, 'Powerful pre-wash laundry spotter. Particularly good on oil, grease spots, cuffs and collars.', false, '', '', '', 'Laundry Prespotter', 'Laundry Prespotter');
INSERT INTO public.chemsapp_product VALUES (621, 'Spray ''N'' Wipe', '', '', '', 'Spray sparingly directly to surfaces. Wipe with a clean cloth, paper towel, or damp sponge. Leaving for 30-
60 secs before wiping will increase product performance and results, especially on greasy or heavy soiling 
buildup. Ensure reusable wipes are thoroughly rinsed then dried for best repeat use. Always aim to minimise 
airborne product.', 'FK-SPRWP05', 'Kemsol', '', '', 72, 'All-purpose anti-bacterial and pleasantly fragranced hard-surface cleaner for use in bathrooms and kitchens. Powerful dirt dissolving formula that easily cuts through grease, oil and other organic-based soiling.', false, '', '', '', 'Antibacterial Surface Cleaner', 'Antibacterial Surface Cleaner');
INSERT INTO public.chemsapp_product VALUES (622, 'Spring Clean', '', '', '', 'As a spray’n’wipe use at a ratio of 1:20 (5% solution, 
50ml or 1/4 cup per litre) with potable cold water.
For medium-duty wet-mop cleaning use at a ratio 
of 1:100 (1% solution, 10ml per litre or 1/4 cup per 
5ltrs) with potable warm or cold water.', 'FK-SPC05', 'Kemsol', '', '', 72, 'Mild pH multi-purpose cleaner for a wide range of hard surfaces, including polished floors, walls and benches. Septic tank safe, when used as directed.', false, '', '', '', 'Cleaner Detergent Concentrate', 'Cleaner Detergent Concentrate');
INSERT INTO public.chemsapp_product VALUES (623, 'Stain-Enz', '', '', '', 'Spray directly onto stain. Amount dispersed should be in relation to the extent of the stain. Use more for 
heavier stains or marks. Leave for 5-10 minutes. Wash or re-wash as usual. Results may vary due to the wide 
nature of stains and often unknown sources, and the wide variety of garment types available. We encourage 
trialling to ensure suitability and compatibility. If treated fabric directly or indirectly comes in contact with 
edible product, a thorough rinse with potable water must follow the laundering process.', 'FK-STAEN05', 'Kemsol', '', '', 72, 'Ready to use spray laundry pre-wash or post-wash stain remover. Spray directly onto blood, food, protein, grass and other organic based soiling. Designed for use in conjunction with the Kemsol laundry system and safe on most common fabrics and linen varieties. Do not use on silk, woollen or other delicates.', false, '', '', '', 'Enzyme Laundry Spotter Treatment', 'Enzyme Laundry Spotter Treatment');
INSERT INTO public.chemsapp_product VALUES (624, 'Stain-Solv', '', '', '', 'Spray directly onto stain. Amount dispersed should be in relation to the extent of the stain. Use more 
for heavier stains or marks. Leave for 5-10 minutes. Wash or re-wash as usual. Results may vary due to 
the wide nature of stains and often unknown sources, and the wide variety of garment types available. 
We encourage trialling to ensure suitability and compatibility. If treated fabric directly or indirectly 
comes in contact with edible product, a thorough rinse with potable water must follow the laundering 
process.', 'FK-STASO05', 'Kemsol', '', '', 72, 'Ready-to-use spray laundry pre-wash or post-wash stain remover. Spray directly onto carbon, grease, oil, lipstick, shoe polish and other petroleum based soiling. Designed for use in conjunction with the Kemsol laundry system and safe on most common fabrics and linen varieties. Do not use on silk, woollen or other delicates.', false, '', '', '', 'Solvent Laundry Spotter Treatment', 'Solvent Laundry Spotter Treatment');
INSERT INTO public.chemsapp_product VALUES (625, 'Steri-Dry', '', '', '', 'NO-RINSE APPLICATION
This product may be used as a no-rinse sanitiser on 
clean hard surfaces. Before use, all edible product and 
packaging material must be removed from the room 
or carefully protected. After use, a rinse with potable 
water is not required but food contact surfaces must 
be thoroughly drained / dried to minimise residues.
Use undiluted. Apply on the surface clean of visible 
soiling. Allow a minimum 1 minute of contact time, 
wipe or leave it to dry.
FOR MPI APPROVED AND MULTI-SITE FACILITIES 
GOVERNED BY THE NZ ANIMAL PRODUCTS 
ACT 1999
To sanitise benches, chopping boards, cooking 
equipment and food contact hard surfaces:
Keeping atomised product to a minimum, apply 
undiluted to a clean dry cloth or paper towel, wipe 
evenly over surfaces and leave to dry - or spray 
sparingly directly onto hard surfaces and wipe with a 
clean cloth or paper towel. Leave for at least 1 minute 
to allow sanitising to complete. After the sanitising 
process is complete, the surfaces should be rinsed, 
unless used as part of fish processing operations 
for which however food contact surfaces must be 
thoroughly drained/dried to minimise residues.
To sanitise electrical housings, control switch gear and 
non-food contact hard surfaces: Ensure all electrical 
and electronic components are disconnected from 
power supply. Apply product as described above, for at least 1 minute contact 
time. Not suitable for large, open areas. Before use, all edible products and 
packaging materials must be removed from the area or carefully protected.', 'FK-STESAN05', 'Kemsol', '', '', 72, 'Powerful, no-rinse, alcohol-based sanitiser that evaporates leaving surfaces dry and disinfected. May be used to maintain sanitary conditions on a variety of surfaces, particularly around moisture sensitive areas such as conveyors, switch gear and electronic components. May be used as a no-rinse sanitiser on food contact surfaces in fish processing operations. If used as a hand sanitiser, spray on clean and dry hands and allow to evaporate. Use of moisturising lotion is recommended to prevent skin dryness.', false, '', '', '', 'Evaporating Sanitiser', 'Evaporating Sanitiser');
INSERT INTO public.chemsapp_product VALUES (626, 'Super Blue', '', '', '', 'For general microbial control of floors and hard surfaces use at a ratio of 1:80 (1.25% solution, 12.5mls per litre) 
with potable warm or cold water. 
For periodic disinfection use at a ratio of 1:40 (2.5% solution, 25mls per litre) with potable warm or cold water. 
For thorough microbial control and contaminated areas use at a ratio of 1:20 (5% solution, 50mls per litre).
Brush, wipe or wet mop areas', 'FK-SUPBL05', 'Kemsol', '', '', 72, 'Premium grade janitorial and washroom area disinfectant effective in controlling a wide range of bacteria and fungi. High quality pine oil boosts product’s antimicrobial performance and leaves pleasant lingering aroma. Septic tank safe, when used as directed.', false, '', '', '', 'Premium Disinfectant', 'Premium Disinfectant');
INSERT INTO public.chemsapp_product VALUES (627, 'Super Clean', '', '', '', 'For light cleaning use at a ratio of 1:60 (1.6% solution, 16mls per litre) with potable water.
For medium cleaning use at a ratio of 1:40 (2.5% solution, 25mls per litre).
For heavy cleaning use at a ratio of 1:9(10% solution, 100mls per litre).
For degreasing use at a ratio of 1:3 (33% solution, 333mls per litre).', 'FK-SUPCLECA05', 'Kemsol', '', '', 72, 'Concentrated biodegradable cleaning agent suitable for the effective removal of a wide range of soiling types, including mineral and vegetable oil, animal and vegetable fats, waxes, clays and carbon. Excellent on automotive soiling and workshop floors.', false, '', '', '', 'Multipurpose Cleaner', 'Multipurpose Cleaner');
INSERT INTO public.chemsapp_product VALUES (628, 'Surtex', '', '', '', 'Light soiling: 8-10mls per kg. 
Medium soiling: 10-12mls per kg. 
Heavy soiling: 12-14mls per kg. 
Do not apply directly to fabric surfaces without diluting.', 'FK-SURTEX05', 'Kemsol', '', '', 72, 'Powerful textile detergent for use in commercial laundry applications. It contains a concentrated low-foam surfactant blend designed for maximum performance in both hard and soft water.', false, '', '', '', 'Commercial Laundry Concentrate', 'Commercial Laundry Concentrate');
INSERT INTO public.chemsapp_product VALUES (629, 'Sweet Sense', '', '', '', 'For general cleaning/disinfecting and microbial control use at a ratio of 1:100 (1% solution, 10mls per litre) with warm 
or cold potable water. Stronger dilution rates will yield faster and longer lasting results. Apply by manually wiping, 
brushing or wet-mopping', 'FK-SWESE05', 'Kemsol', '', '', 72, 'Premium grade combined cleaner and disinfectant, effective in controlling a wide range of bacteria, moulds and fungi. It has a powerful and distinctive sweet fragrance that lingers. Septic tank safe, when used as directed.', false, '', '', '', 'Premium Disinfectant', 'Premium Disinfectant');
INSERT INTO public.chemsapp_product VALUES (630, 'Swift', '', '', '', 'Add 20mls (4 tsp) to a sink full of warm potable water. 
Mix and wash dishes as normal. May be rinsed prior to 
air or clean-towel drying', 'FK-SWT05', 'Kemsol', '', '', 72, 'General purpose, biodegradable manual dishwash detergent for everyday use on all kitchen utensils, glassware, crockery pots and pans. Septic tank safe, when used as directed.', false, '', '', '', 'Manual Dishwashing Detergent', 'Manual Dishwashing Detergent');
INSERT INTO public.chemsapp_product VALUES (631, 'Tender', '', '', '', 'Add 50-75mls per average laundry wash load. Place only in fabric softener dispenser or add to final rinse to 
avoid interaction with washing detergent.', ' FK-TENFAB05', 'Kemsol', '', '', 72, 'Imparts softness to both cotton and blended fabrics and reduces static-cling and linting. Also contains a soft fragrance that remains with fabrics after drying. Septic tank safe, when used as directed.', false, '', '', '', 'Fragranced Fabric Softener', 'Fragranced Fabric Softener');
INSERT INTO public.chemsapp_product VALUES (632, 'Top Notch', '', '', '', 'Light Mopping: Dilute 100ml/5LTRS cold water (½ cup).
Medium Mopping: Dilute 150ml/5LTRS cold water (¾ cup). 
Heavy Cleaning: Dilute 100ml/1LTR cold water (½ cup). 
Degreasing: Dilute 300ml/1LTR cold water (1½ cups). 
Suitable for use with septic tanks', 'FK-TOPN05', 'Kemsol', '', '', 72, 'Degreaser and heavy-duty environmentally licensed cleaner for the tough cleaning jobs, such as those on heavily soiled floors, walls, benches and most degreasing applications.', false, '', '', '', 'Multipurpose Cleaner', 'Multipurpose Cleaner');
INSERT INTO public.chemsapp_product VALUES (633, 'Trans-Aqua', '', '', '', 'Spray onto surfaces at a ratio up to 1:200. Apply at low pressure and allow several minutes before 
removing thoroughly with high-pressure fresh water. If streaking occurs, product is being used at too high a 
concentration', 'FK-TRANSAQ05', 'Kemsol', '', '', 72, 'A concentrated cleaning agent designed to remove heavy grime and air borne soiling build-up from a variety of exterior commercial and industrial surfaces. Also effective as a transport cleaner for fleet operations.', false, '', '', '', 'Pressure Cleaning Agent', 'Pressure Cleaning Agent');
INSERT INTO public.chemsapp_product VALUES (634, 'Tropic Breeze', '', '', '', 'Spray undiluted and sparingly into the air using a pump action spray bottle. Instantly reacts with noxious 
odours to leave the atmosphere with a fresh, long lasting fragrance', 'BK-TROP01', 'Kemsol', '', '', 72, 'Long lasting air freshener and deodoriser with a two-stage effect, neutralising odours while leaving a lasting tropical fragrance. Biodegradable and contains an advanced high-strength odour neutralising agent, effective against a wide range of odours from a variety of sources.', false, '', '', '', 'Air Freshener', 'Air Freshener');
INSERT INTO public.chemsapp_product VALUES (635, 'Tuff Suds', 'documents/TUFF_SUDS.jpg', '', '', 'Manual sink washing application, use at a ratio of 1:500 (0.25% soln, 25mls per 10ltrs) in warm potable water 
(more or less depending on soiling levels).
Dishes and equipment may be washed immediately or left to soak to improve results. May be rinsed prior to 
air or clean-towel drying.', 'FK-TUFF05', 'Kemsol', 'documents/Tuff_Suds_-_PI.pdf', 'documents/KEMSOL_-_Tuff_Suds_-_SDS.pdf', 72, 'Powerful concentrated manual dishwash with medium foam. Particularly effective in commercial kitchens for fatty dishes. Septic tank safe, when used as directed.', false, '', '', '', 'Hand Dishwash Detergent', 'Hand Dishwash Detergent');
INSERT INTO public.chemsapp_product VALUES (636, 'Turbo', '', '', '', 'Light soiling 1:100. Spray onto the truck at low pressure. Allow to soak for a few minutes. Remove with 
fresh water at high pressure. Do not allow to dry before washing off.
Heavy soiling 1:25. (With high pressure waterblasters refer to instruction manual for dilution rates.', 'FK-TURB05', 'Kemsol', '', '', 72, 'Heavy-duty truck wash developed for New Zealand conditions.', false, '', '', '', 'Truck Wash', 'Truck Wash');
INSERT INTO public.chemsapp_product VALUES (637, 'Blast Kleen', 'documents/141310_RD3YzlY.jpg', '', '', 'LIGHT CLEAN: Dilute 3:1000 use 3ml per 1L of water
MED CLEAN: Dilute 5:1000 use 5ml per 1L of water
HEAVY CLEAN: Dilute 10:1000 use 10ml per 1L of water', 'RAP', 'Rapid', 'documents/BlastKleen_TDS_NZ.pdf', 'documents/BlastKleen_TDS_NZ_E398c66.pdf', 69, 'Heavy Duty Multipurpose Cleaner/Degreaser is a concentrated eco-preferred cleaner which is effective on medium to heavy soiled surfaces. With a solvent and low foaming surfactant blend for excellent grease cutting properties. A degreaser and heavy-duty cleaner for the tough cleaning jobs, such as heavily soiled floors, walls, benches and most degreasing applications.
MPI Approved C31 (All animal product except dairy)', false, '', '', '', 'Heavy Duty Multipurpose Cleaner/Degreaser', 'Heavy Duty Multipurpose Cleaner/Degreaser');
INSERT INTO public.chemsapp_product VALUES (638, 'Neutrol', 'documents/140440-1.jpg', 'documents/Floor_Cleaner_Icon_TkZ9Qmr.png', '', 'MEDIUM SOIL – Dilute 1:40 parts of water (250ml in 10 litres water)
HEAVY SOIL – Dilute 1:20 parts of water (500ml in 10 litres water)
SPRAY AND WIPE – Dilute 1 part to 100 parts water.
AUTOSCRUBBERS – Dilute 1 part to 120-150 parts water (1/2 litre per 60 litre autoscrubber tank) or 2-3 cups.', 'RAP140440', 'Rapid', 'documents/NEUTROL_TDS_NZ.pdf', 'documents/INT-RapidNeutrolSDS.pdf', 69, 'Neutrol Low Foaming Detergent is a heavy duty highly concentrated, low foaming Detergent. It combines low foam detergency with soil suspending agents. Neutrol is suitable for use in auto scrubbers and pressure washers, with a mop and bucket or a spray and wipe. Recommended for use on floors, walls, benches, tiles and most other surfaces.', false, '', '', '', 'Low Foaming Detergent', 'Low Foaming Detergent');
INSERT INTO public.chemsapp_product VALUES (639, 'Reflection', 'documents/140340.jpg', 'documents/Glass_Cleaner_Icon_QXPTnBm.png', '', 'Dilute: 50:50 with cold water (100ml : 100ml)
Spray onto glass and wipe surface with anti-static cloth or paper towel', 'RAP140340', 'Rapid', 'documents/REFLECTION_TDS_NZ.pdf', 'documents/INT-RapidReflectionSDS.pdf', 69, 'Reflection Glass Cleaner is formulated to cut through dirt and grease on all surfaces. Spray Reflection Glass Cleaner onto a glass surface or window and wipe it off for a streak free shine. Recommended for glass, mirrors and hard surfaces including; counter tops, stainless steel, chrome, plastic, enamel, ceramic tile, vinyl, granite, porcelain, splash backs and melamine tabletops.', false, '', '', '', 'Glass Cleaner', 'Glass Cleaner');
INSERT INTO public.chemsapp_product VALUES (640, 'Spray & Wipe', 'documents/1664495001.0983696.jpeg', '', 'Cyclone All Purpose Cleaner is a commercial grade disinfectant formulated to lift grease and grime whilst killing 99% of germs', 'As per PI Sheet', '1234', 'Cyclone', '', 'documents/640_Spray__Wipe_sds_sheet.pdf', 94, 'Cyclone All Purpose Cleaner is a commercial grade disinfectant formulated to lift grease and grime whilst killing 99% of germs', false, 'Multipurpose', 'NA', '', '', 'Spray and wipe');
INSERT INTO public.chemsapp_product VALUES (641, 'Auscreen', '', '', 'SPF 50+ to offer a high level of protection', 'Apply liberally and evenly at least 20 minutes before swimming or sun exposure and then reapplied every 2 hours.', '{''ref'': None, ''type'': ''span'', ''props'': {''children'': ['''', [{''ref'': None, ''type'': ''span'', ''props'': {''className'': ''highlight'', ''children'': ''AUS''}, ''key'': ''beep'', ''_owner'': None}, {''ref'': None, ''type'': ''span'', ''props'': {''children'': ''SCREEN''}, ''key'': ''boop'', ''_owner'': None}]]}, ''key'': None, ''_owner'': None}', 'Ultra Protect', '', 'documents/641_Auscreen_sds_sheet.pdf', 61, 'This Auscreen Ultra Protect SPF50+ Sunscreen has been formulated to provide high protection against the sun and harmful UVA and UVB rays. It applies smoothly without being greasy and has a dry-touch formulation.', false, 'Sunscreen', 'SPF 50+ to offer a high level of protection', '', '', 'Sunscreen');
INSERT INTO public.chemsapp_product VALUES (642, 'Ultimo Bio Activ No Rinse Floor & Drain Cleaner', 'documents/BIO_ACTIV_No_Rinse_Floor_and_Drain_Cleaner_3.3L.jpg', '', '', 'For use thru the Ultimo Dispenser unit, dilute at 200:1 (5ml per Litre ) for cleaning floors thru scrubber, foaming unit or bucket mopping. Can be increased to 100:1 for highly soiled areas.', 'ULTIMOBAFLOOR', 'Geller', 'documents/I183_BioActiv_PI.pdf', 'documents/Ultimo_BIO_ACTIV_No-Rinse_Drain__Floor_Cleaner_SDS.pdf', 55, 'BIO ACTIV incorporates biological, enzymes and readily biodegradable ingredients to quickly remove grime, dirt and odour caused by fats, oils and grease from floors and drains.', true, '', '', '', 'Ultra Concentrate Natural Floor Cleaner', '');
INSERT INTO public.chemsapp_product VALUES (643, 'Ultimo Viscos Pot & Pan Detergent', 'documents/VISCOS_Pot_and_Pan_Detergent_3.3L.jpg', '', '', 'Use one dose from Ultimo Dispenser per sink or bucket. Rinse all food contacting surfaces with potable water after use.', 'ULTIMOVPP', 'Geller', 'documents/I183_Viscos_PotPan_PI.pdf', 'documents/Ultimo_VSCOS_Pot__Pan_Detergent_SDS.pdf', 55, 'Ultimo VISCOS Pot & Pan Detergent manual dishwash is ideal for glasses, utensils, crockery, pots & pans. It is safe to use for washing sensitive metals.', true, '', '', '', 'Ultra Concentrate Sink Detergent', '');
INSERT INTO public.chemsapp_product VALUES (644, 'Ultimo Viscos Dish Detergent', 'documents/VISCOS_Dish_Detergent_3.3L.jpg', '', '', 'For use with the Ultimo Dispenser - Inject undiluted directly into wash water via the Ultimo automatic pump. Not recommended for manual dosing, unless in contingency commercial situations. Must be used in conjunction with ULTIMO VSCOS RINSE AID.', 'ULTIMOVDD', 'Geller', '', 'documents/Ultimo_VSCOS_Premium_Dishwash_Detergent_Solution_SDS.pdf', 55, 'Ultimo VISCOS Dish Detergent is formulated for dishwashing applications in hood and conveyor machines.', true, '', '', '', 'Ultra Concentrate Ware Washing Solution', '');
INSERT INTO public.chemsapp_product VALUES (645, 'Ultimo Viscos Premium Rinse Aid', 'documents/VISCOS_Permium_Rinse_Aid_3.3L.jpg', '', '', 'For use with the Ultimo Dispenser - Inject undiluted directly into wash water via the Ultimo automatic pump. Not recommended for manual dosing, unless in contingency commercial situations. Must be used in conjunction with ULTIMO VISCOS DISH DETERGENT.', 'ULTIMOVRA', 'Geller', 'documents/I183_Viscos_Rinse_Aid_PI.pdf', 'documents/Ultimo_VSCOS_Premium_Rinse_Solution_SDS.pdf', 55, 'Ultimo Premium Rinse is formulated for dishwashing applications in hood and conveyor machines.', true, '', '', '', 'Ultra Concentrate Rinse Aid Solution', '');
INSERT INTO public.chemsapp_product VALUES (646, 'Ultimo Duel Power Blast Foaming Degreaser', 'documents/DUEL_Power_Blast_Foaming_Degeaser_3.3L.jpg', '', '', 'For use with the Ultimo Dispenser and Foaming unit, dilute at 200:1 (5ml per Litre). Can be increased to 100:1 (10ml per Litre) for highly soiled areas.', 'ULTIMODPBD', 'Geller', 'documents/I183_Duel_Power_Blast_PI.pdf', 'documents/Ultimo_DUEL_Power_Blast_Degreaser_SDS.pdf', 55, 'Ultimo DUEL Power Blast is an advanced foaming cleaner and a low-temp degreaser, giving increased contact time and superior protein removal at lower temps.', true, '', '', '', 'Ultra Concentrate Foaming Cleaner', '');
INSERT INTO public.chemsapp_product VALUES (647, 'Green - Glass Cleaner', 'documents/Glass.png', '', '', 'Dispense through Promax dilution centre alternatively use neat or dilute 50:50 with cold water (100ml:100ml)

SPRAY onto glass. Wipe over complete surface with anti-static cloth or paper towel to give a sparkling, streak-free finish.', 'GGGLASS05', 'Geller', 'documents/GG_GlassCleaner_PI.pdf', 'documents/Geller_Glass_Cleaner_SDS_wPx5yQ7.pdf', 72, 'Geller®Green Glass Cleaner leaves glass and windows clean, streak-free and repels surface dust for days after use. Glass Cleaner is one of the most environmentally friendly glass cleaners available in New Zealand. Shake well before use. For best results and a streak free shine, spray onto surface and clean with a paper towel or lint free cloth until dry. Change cloth/paper towel as required.', true, '', '', 'GGGLASS15', 'Glass Cleaner', '');
INSERT INTO public.chemsapp_product VALUES (648, 'Green - Spray N Wipe', 'documents/Spray_4w5wKBw.png', '', '', 'Dispense through Promax dilution centre alternatively Dilute 20ml per 1L of cold water. Spray on cloth. Wipe on, wipe off. Rinse with clean water.', 'GGSNW05', 'Geller', 'documents/GG_SprayWipe_PI.pdf', 'documents/Geller_Spray__Wipe_SDS_ygghjFB.pdf', 72, 'Geller®Green All Purpose Cleaner and Spray N Wipe is an eco-safe concentrated, bio-degradable all-purpose cleaner, formulated to quickly penetrate, emulsify and remove light to medium soils. From kitchens, cafeterias, boardrooms, rest rooms & offices our natural all-purpose cleaner cuts grease, grime and dirt as well as traditional cleaners. But because it’s made from plants and minerals it leaves no harsh chemical fumes or residue. And since it’s 100% natural, it’s better for the environment too.', true, '', '', 'GGSNW15', 'Spray N Wipe', '');
INSERT INTO public.chemsapp_product VALUES (649, 'Rapid Lemon Fresh', 'documents/Rapid_Lemon_Fresh_5L.jpg', '', 'For hard surface treatment for bathrooms, janitorial floors and toilet surfaces use at a ratio of 1:100 - 1:50 (1-2% soln, 10-20mls per litre) with warm or cold potable water', 'For hard surface treatment for bathrooms, janitorial floors and toilet surfaces use at a ratio of 1:100 - 1:50 (1-2% soln, 10-20mls per litre) with warm or cold potable water. For extended microbial activity double the recommended dosage.
Use undiluted as a deodoriser or in exceptionally unsanitary conditions.  Either wipe or spray onto surfaces, leave for a few moment, then wipe clean.', 'RAP140300', 'Rapid', '', 'documents/Rapid_Lemon_Fresh_SDS_2021.pdf', 61, 'A concentrated, commercial grade disinfectant-sanitiser-deodoriser and Cleaner combination ideal for restaurants, bars, hotels/motels, educational & health facilities, and other public use facilities where a hygienic smell and appearance are critical.

MPI APPROVED C32 (All animal product except dairy) Dishes and equipment may be washed immediately or left to soak to improve results. May be rinsed prior to air or clean-towel drying. In food processing premises, after using this compound, food contact surfaces must be thoroughly rinsed with potable water before production starts', false, '', '', 'CODE: RAP140300|Lemon Fresh 5ltr', 'Commercial Cleaner Disinfectant', 'A concentrated, commercial grade disinfectant-sanitiser-deodoriser');
INSERT INTO public.chemsapp_product VALUES (650, 'Sweet Lemon Deodorizer', 'documents/Sweet_Lemon_Pic.avif', '', '', 'Dilution Ratios: 1/2-8 oz./gal', 'CH14162', 'BridgePoint', '', 'documents/SDS_Sweet_Lemon.pdf', 61, 'Sweet Lemon Deodorizer is a heavy duty odor control product that is ideal for general deodorizing of carpets and fabrics, yet powerful enough for a broad range of malodors. Can be used as a direct spray or as an additive to your cleaning solutions.
Designed for use on carpet, upholstery, laundry and general space deodorizing, these formulas attack odors caused by decomposition. The pleasant fragrance covers the offending odor while the deodorizing agents go to work on the source. These are safe deodorizers with no oxidizing or bleaching agents. That means you can add them to virtually any cleaning compound you want to have a pleasant fragrance.', false, '', '', 'CH14162', 'Deodorizer', 'Deodorizer');
INSERT INTO public.chemsapp_product VALUES (651, 'Helix Commercial Bleach', 'documents/Comm_Bleach_5L_600p.jpg', 'documents/Bleach_In_Sink_Icon.png', '', 'Bleaching of Clothes - Manual Dilute BLEACH 20 mls per 10 litre of cold water, Soak for 10 minutes. Rinse thoroughly with clean water.

