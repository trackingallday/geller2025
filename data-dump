INSERT INTO public.chemsapp_product VALUES (654, 'Saniplus', 'documents/5329845_-_SaniPlus_5L_Vjxigb6.jpg', 'documents/5329845_-_SaniPlus_5L.jpg', '', 'Never mix SaniPlus with other chemicals, as it may reduce effectiveness. Begin by removing all equipment and manually scraping off any gross soiling, discarding it hygienically. Dilute as per Label Instructions  with clean water, then apply using a spray bottle or cloth, ensuring the entire area is covered. Allow the solution to remain on the surface for at least five minutes to ensure proper sanitisation. Afterward, wipe or rinse the area to remove any remaining solution. Leave the surface to air dry thoroughly or dry it with a clean towel. SaniPlus, when used at the correct dilution, is safe for plastics, aluminium, stainless steel, and fabrics. Contains: Alkyldimethyl Benzyl Ammonium Chloride and Didecyl Dimethyl Ammonium Chloride.

LIGHT MAINTENANCE  (1:5)- - 150ml in to Spray Bottle
MAINTENANCE CLEANING -(1:2) - 350ml in to Spray Bottle	
