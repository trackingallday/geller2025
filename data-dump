INSERT INTO public.chemsapp_product VALUES (484, 'Ultimo 2 . Heavy Duty Degreaser', 'documents/Ultimo_2_-_All_Purpose_HD_Degreaser.Cleaner.jpg', '', '', 'Use one dose from Ultimo Dispenser per bottle or bucket. Use a mop or spray on to surfaces to be cleaned. Rinse all food contacting surfaces with potable water after use.', 'ULTIMO2', 'Geller', 'documents/I183_No2_All_Purpose_PI.pdf', 'documents/Ultimo_2_HD_Degreaser-Cleaner_Fragrance_SDS.pdf', 55, 'Ultimo 2. HD Degreaser/Cleaner is a heavyduty universal cleaner and degreaser. Can be used to remove grease and fat in food preparation areas. For use where the surface is not adversely affected by alkalinity.', true, '', '', '', 'Ultra Concentrate', '');
INSERT INTO public.chemsapp_product VALUES (485, 'Ultimo 3. Washroom Cleaner', 'documents/Ultimo_3_-_Washroom_Cleaner.jpg', '', '', 'Use one dose from Ultimo Dispenser per bottle or bucket. Use a mop or spray on to surfaces to be cleaned. Rinse all food contacting surfaces with potable water after use.', 'ULTIMO3', 'Geller', 'documents/I183_No3_Washroom_PI.pdf', 'documents/Ultimo_3_Washroom_Cleaner_SDS.pdf', 55, 'Ultimo 3. Washroom Cleaner is non perfumed, high performance quaternary based disinfectant and cleaner. This general purpose cleaner sanitiser can be used on all hard surfaces.', true, '', '', '', 'Ultra Concentrate', '');
INSERT INTO public.chemsapp_product VALUES (486, 'Ultimo 4. Neutral Floor Cleaner', 'documents/Ultimo_4_-_Neutral_Floor_Cleaner.jpg', '', '', 'Use one dose from Ultimo Dispenser per bottle or bucket. Use a mop or spray on to surfaces to be cleaned. Rinse all food contacting surfaces with potable water after use.', 'ULTIMO4', 'Geller', 'documents/I183_No4Neutral_Floor_PI.pdf', 'documents/Ultimo_4_Neutral_Floor_Cleaner_SDS.pdf', 55, 'Ultimo 4. Neutral Floor Cleaner is Ph Neutral for use as maintenance floor cleaner. Contains solvents for improved cleaning power. It is nonstaining and safe to use on all common surfaces.', true, '', '', '', 'Ultra Concentrate', '');
