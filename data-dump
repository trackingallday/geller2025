INSERT INTO public.chemsapp_product VALUES (659, 'Spot Aid', 'documents/5329846_-_SpotFree_Rinse_Aid_5L_H9sTDPb.jpg', 'documents/5329846_-_SpotFree_Rinse_Aid_5L.jpg', '', 'Spot Aid  is introduced during the rinse cycle at a very low concentration of 7-10 ml/45L of water via automatic dosing equipment.  For best results flash drying at 80-90°C is recommended. In domestic dishwashers the rinse additive is dispensed from a small reservoir unit which must be kept full.

