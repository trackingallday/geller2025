INSERT INTO public.chemsapp_product VALUES (132, 'Bioindustrial', 'documents/BioIndustrial.jpg', 'documents/Floor_Cleaner_Icon.png', '', 'Heavy Duty cleaning: Using cold to warm water, Dilute at  75 - 100 mls per litre. Apply with Foam Spray head or Mop Deep clean using a Stiff brush or first clean if possible leave overnight. When finished mopping dispose of liquid into a toilet or urinal to maximize the benefit of the Bio-Agent.

