INSERT INTO public.chemsapp_product VALUES (29, 'Lu Blue', 'documents/LuBlu_PM89ySX.jpg', 'documents/Toilet_Bowl_Cleaner_Icon.png', 'Please contact us to get a copy of our Product Information Sheet', 'Toilet bowls: Squirt or wipe onto surface. For best results leave for 2 minutes, agitate, then rinse with clean water.
